+import { FormBuilder } from "@angular/forms";
+
+import { LoginComponent } from "./login.component";
+
+// Instantiate the real form without running lifecycle hooks or contacting a server.
+describe("Vault login password compatibility", () => {
+  const services = Array(25).fill(undefined);
+  services[6] = new FormBuilder();
+  services[14] = { getClientType: () => 0 };
+
+  it.each(["a", "!", " a! ", "a".repeat(12), "a".repeat(13), "existing-long-password!".repeat(8)])(
+    "accepts existing and short passwords without changing their value",
+    (password) => {
+      const component = Reflect.construct(LoginComponent, services) as LoginComponent;
+      const control = component.formGroup.controls.masterPassword;
+      control.setValue(password);
+      expect(control.valid).toBe(true);
+      expect(control.value).toBe(password);
+    },
+  );
+
+  it("rejects an empty password", () => {
+    const component = Reflect.construct(LoginComponent, services) as LoginComponent;
+    expect(component.formGroup.controls.masterPassword.invalid).toBe(true);
+  });
+});
