+import { describe, expect, test } from "bun:test";
+import { readFileSync } from "node:fs";
+
+import JSON5 from "json5";
+
+import { PureCrypto, type Kdf } from "@bitwarden/sdk-internal";
+
+// All input is public dummy data. Exercise the pinned client's real WASM crypto;
+// do not connect to a server, load account state, or log keys or wrapped keys.
+const salt = "dummy@example.invalid";
+const kdfs: [string, Kdf][] = [
+  ["PBKDF2", { pBKDF2: { iterations: 600000 } }],
+  ["Argon2id", { argon2id: { iterations: 3, memory: 64, parallelism: 4 } }],
+];
+
+for (const [name, kdf] of kdfs) {
+  describe(`Vault password compatibility: ${name}`, () => {
+    test.each(["a", "a!b?C d#e$F%", "long-existing-password!".repeat(6)])(
+      "unwraps the same user key with the full password",
+      (password) => {
+        const key = PureCrypto.make_user_key_aes256_cbc_hmac();
+        const wrapped = PureCrypto.encrypt_user_key_with_master_password(key, password, salt, kdf);
+        const recovered = PureCrypto.decrypt_user_key_with_master_password(
+          wrapped,
+          password,
+          salt,
+          kdf,
+        );
+        expect(Buffer.from(key).equals(Buffer.from(recovered))).toBe(true);
+        expect(() =>
+          PureCrypto.decrypt_user_key_with_master_password(wrapped, password + "x", salt, kdf),
+        ).toThrow();
+      },
+      30000,
+    );
+
+    test("rewraps a legacy key with a short password while retaining encrypted items", () => {
+      const key = PureCrypto.make_user_key_aes256_cbc_hmac();
+      const item = PureCrypto.symmetric_encrypt_string("public dummy vault item", key);
+      const legacyPassword = "legacy-password-longer-than-twelve!";
+      const oldWrapped = PureCrypto.encrypt_user_key_with_master_password(
+        key,
+        legacyPassword,
+        salt,
+        kdf,
+      );
+      const recovered = PureCrypto.decrypt_user_key_with_master_password(
+        oldWrapped,
+        legacyPassword,
+        salt,
+        kdf,
+      );
+      const newWrapped = PureCrypto.encrypt_user_key_with_master_password(
+        recovered,
+        "!",
+        salt,
+        kdf,
+      );
+      const newRecovered = PureCrypto.decrypt_user_key_with_master_password(
+        newWrapped,
+        "!",
+        salt,
+        kdf,
+      );
+      expect(
+        PureCrypto.symmetric_decrypt_string(item, newRecovered) === "public dummy vault item",
+      ).toBe(true);
+      expect(Buffer.from(key).equals(Buffer.from(newRecovered))).toBe(true);
+      // Both strings share their first twelve characters: this catches truncation.
+      expect(() =>
+        PureCrypto.decrypt_user_key_with_master_password(
+          oldWrapped,
+          legacyPassword.slice(0, 12),
+          salt,
+          kdf,
+        ),
+      ).toThrow();
+      expect(() =>
+        PureCrypto.decrypt_user_key_with_master_password(
+          oldWrapped,
+          legacyPassword + "different",
+          salt,
+          kdf,
+        ),
+      ).toThrow();
+    }, 30000);
+  });
+}
+
+test("Bun migration retains upstream resolved package versions", () => {
+  const original = JSON.parse(
+    readFileSync(new URL("../package-lock.json", import.meta.url), "utf8"),
+  );
+  const migrated = JSON5.parse(readFileSync(new URL("../bun.lock", import.meta.url), "utf8"));
+  const versions = new Set(
+    Object.entries(original.packages)
+      .filter(([path, entry]: [string, any]) => path.includes("node_modules/") && entry.version)
+      .map(
+        ([path, entry]: [string, any]) =>
+          `${path.slice(path.lastIndexOf("node_modules/") + 13)}@${entry.version}`,
+      ),
+  );
+  const packages = Object.values(migrated.packages)
+    .map((entry: any) => entry[0] as string)
+    .filter((id) => !id.includes("@workspace:") && !id.includes("@file:"));
+  expect(packages.length).toBeGreaterThan(2000);
+  expect(packages.every((id) => versions.has(id))).toBe(true);
+});
