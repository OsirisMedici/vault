+++ b/apps/web/src/app/vault/services/vault-mac-copy.service.ts
@@ -0,0 +1,136 @@
+import { Injectable, NgZone, inject } from "@angular/core";
+import { firstValueFrom } from "rxjs";
+
+import { AccountService } from "@bitwarden/common/auth/abstractions/account.service";
+import { AuthService } from "@bitwarden/common/auth/abstractions/auth.service";
+import { AuthenticationStatus } from "@bitwarden/common/auth/enums/authentication-status";
+import { EventCollectionService, EventType } from "@bitwarden/common/dirt/event-logs";
+import { uuidAsString } from "@bitwarden/common/platform/abstractions/sdk/sdk.service";
+import { CipherService } from "@bitwarden/common/vault/abstractions/cipher.service";
+import { CipherRepromptType, CipherType } from "@bitwarden/common/vault/enums";
+import { CipherViewLikeUtils } from "@bitwarden/common/vault/utils/cipher-view-like-utils";
+import { PasswordRepromptService } from "@bitwarden/vault";
+
+type Request = {
+  url: string;
+  field: "login" | "password";
+  id: string;
+  allowReprompt: boolean;
+};
+
+@Injectable({ providedIn: "root" })
+export class VaultMacCopyService {
+  private readonly accounts = inject(AccountService);
+  private readonly auth = inject(AuthService);
+  private readonly ciphers = inject(CipherService);
+  private readonly reprompt = inject(PasswordRepromptService);
+  private readonly events = inject(EventCollectionService);
+  private readonly zone = inject(NgZone);
+
+  register() {
+    if (!navigator.userAgent.endsWith(" VaultMacMenu/1")) {
+      return;
+    }
+
+    Object.defineProperty(window, "vaultMacCopy", {
+      value: (request: Request) => this.zone.run(() => this.prepareCopy(request)),
+    });
+  }
+
+  private async prepareCopy(request: Request) {
+    if (!request || !["login", "password"].includes(request.field)) {
+      return { status: "unavailable" };
+    }
+
+    let url: URL;
+    try {
+      url = new URL(request.url);
+    } catch {
+      return { status: "unavailable" };
+    }
+    if (url.protocol !== "https:" || url.username || url.password || url.port) {
+      return { status: "unavailable" };
+    }
+
+    const account = await firstValueFrom(this.accounts.activeAccount$);
+    if (!account || (await this.auth.getAuthStatus(account.id)) !== AuthenticationStatus.Unlocked) {
+      return { status: "locked" };
+    }
+
+    const host = url.hostname.replace(/^www\./, "");
+    const findMatches = async () =>
+      (await this.ciphers.getAllDecryptedForUrl(url.href, account.id)).filter(
+        (cipher) =>
+          cipher.type === CipherType.Login &&
+          !cipher.isArchived &&
+          !cipher.isDeleted &&
+          cipher.viewPassword &&
+          !!cipher.id &&
+          !!cipher.login?.password &&
+          (request.field === "password" || !!cipher.login.username) &&
+          cipher.login.uris?.some(
+            (uri) => CipherViewLikeUtils.getUriHostname(uri)?.replace(/^www\./, "") === host,
+          ),
+      );
+
+    const matches = await findMatches();
+    const currentAccount = async () =>
+      (await firstValueFrom(this.accounts.activeAccount$))?.id === account.id &&
+      (await this.auth.getAuthStatus(account.id)) === AuthenticationStatus.Unlocked;
+
+    if (!(await currentAccount())) {
+      return { status: "locked" };
+    }
+    if (matches.length === 0) {
+      return { status: "noMatch" };
+    }
+
+    const selected = request.id
+      ? matches.find((cipher) => cipher.id === request.id)
+      : matches.length === 1
+        ? matches[0]
+        : undefined;
+    if (!selected) {
+      return {
+        status: "choose",
+        choices: matches.map((cipher) => ({
+          id: cipher.id,
+          label: [cipher.name, cipher.login.username].filter(Boolean).join(" · "),
+        })),
+      };
+    }
+
+    let cipher = selected;
+    if (cipher.reprompt !== CipherRepromptType.None) {
+      if (!request.allowReprompt || request.id !== cipher.id) {
+        return { status: "reprompt", id: cipher.id };
+      }
+      if (!(await this.reprompt.showPasswordPrompt())) {
+        return { status: "cancelled" };
+      }
+      const refreshed = (await findMatches()).find((item) => item.id === cipher.id);
+      if (!refreshed || !(await currentAccount())) {
+        return { status: "unavailable" };
+      }
+      cipher = refreshed;
+    }
+
+    await this.events.collect(
+      EventType.Cipher_ClientCopiedPassword,
+      uuidAsString(cipher.id),
+      false,
+      cipher.organizationId ? uuidAsString(cipher.organizationId) : undefined,
+    );
+    if (!(await currentAccount())) {
+      return { status: "locked" };
+    }
+
+    return {
+      status: "ready",
+      id: cipher.id,
+      value: request.field === "password"
+        ? cipher.login.password
+        : [cipher.login.username, cipher.login.password].join("\n"),
+    };
+  }
+}
