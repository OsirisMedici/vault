diff --git a/libs/common/src/vault/utils/login-site-label.ts b/libs/common/src/vault/utils/login-site-label.ts
new file mode 100644
index 0000000..eec5806
--- /dev/null
+++ b/libs/common/src/vault/utils/login-site-label.ts
@@ -0,0 +1,33 @@
+const siteLabels = new Map<string, { name: string; searchAlias?: string }>([
+  ["github.com", { name: "GitHub" }],
+  ["accounts.google.com", { name: "Google", searchAlias: "Gmail" }],
+  ["mail.google.com", { name: "Gmail", searchAlias: "Google" }],
+  ["notion.so", { name: "Notion" }],
+  ["notion.com", { name: "Notion" }],
+  ["app.notion.com", { name: "Notion" }],
+  ["slack.com", { name: "Slack" }],
+  ["app.slack.com", { name: "Slack" }],
+  ["instagram.com", { name: "Instagram" }],
+  ["gohighlevel.com", { name: "HighLevel" }],
+  ["app.gohighlevel.com", { name: "HighLevel" }],
+]);
+
+export function loginSiteLabel(hostname: string) {
+  return siteLabels.get(hostname.toLowerCase().replace(/^www\./, ""));
+}
+
+export function loginDisplayName(name: string, hostname: string, username?: string | null) {
+  const label = loginSiteLabel(hostname);
+  if (!label) {
+    return name;
+  }
+
+  const title = name.trim().toLowerCase();
+  const host = hostname.toLowerCase();
+  const bareHost = host.replace(/^www\./, "");
+  return [host, bareHost].some(
+    (domain) => title === domain || (username && title === domain + " (" + username.toLowerCase() + ")"),
+  )
+    ? label.name
+    : name;
+}
