@@ -0,0 +1,105 @@
+.vault-collection-toolbar {
+  /* Cult UI Toolbar Expandable uses a 250 ms Motion spring with 0.1 bounce.
+     These stops sample that spring for Angular without a second UI runtime. */
+  --vault-collection-spring: linear(
+    0, 0.0698, 0.2176, 0.3835, 0.5372, 0.6662, 0.7677, 0.8438, 0.8986, 0.9367, 0.9623,
+    0.9789, 0.9893, 0.9954, 0.9989, 1.0006, 1.0013, 1.0015, 1.0014, 1.0012, 1
+  );
+
+  margin-block-end: 0.75rem;
+}
+
+.vault-collection-trigger,
+.vault-collection-choice {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  min-height: 2.25rem;
+  max-width: 100%;
+  padding: 0.375rem 0.625rem;
+  border: 1px solid rgb(var(--color-secondary-300));
+  border-radius: 0.5rem;
+  background: rgb(var(--color-background));
+  color: rgb(var(--color-text-main));
+  font-size: 0.875rem;
+  font-weight: 500;
+  text-align: start;
+  overflow-wrap: anywhere;
+}
+
+.vault-collection-trigger:hover,
+.vault-collection-choice:hover {
+  background: rgb(var(--color-background-alt));
+}
+
+.vault-collection-trigger[aria-expanded="true"],
+.vault-collection-trigger.vault-collection-active,
+.vault-collection-choice[aria-pressed="true"] {
+  border-color: rgb(var(--color-primary-600));
+  color: rgb(var(--color-primary-600));
+}
+
+.vault-collection-trigger:focus-visible,
+.vault-collection-choice:focus-visible {
+  outline: 2px solid rgb(var(--color-primary-600));
+  outline-offset: 2px;
+}
+
+.vault-collection-chevron {
+  transition: transform 250ms ease-out;
+  transition-timing-function: var(--vault-collection-spring, ease-out);
+}
+
+.vault-collection-trigger[aria-expanded="true"] .vault-collection-chevron {
+  transform: rotate(180deg);
+}
+
+.vault-collection-unfold {
+  display: grid;
+  grid-template-rows: 0fr;
+  transition: grid-template-rows 250ms ease-out;
+  transition-timing-function: var(--vault-collection-spring, ease-out);
+}
+
+.vault-collection-unfold-open {
+  grid-template-rows: 1fr;
+}
+
+.vault-collection-clip {
+  min-height: 0;
+  overflow: hidden;
+}
+
+.vault-collection-choices {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+  max-height: 15rem;
+  overflow: auto;
+  padding: 0.625rem;
+  border: 1px solid rgb(var(--color-secondary-300));
+  border-radius: 0.75rem;
+  background: rgb(var(--color-background-alt));
+}
+
+.vault-collection-choice small {
+  display: block;
+  color: rgb(var(--color-text-muted));
+}
+
+.vault-collection-marker {
+  flex: none;
+  min-width: 1.375rem;
+  padding: 0.125rem;
+  border-radius: 0.25rem;
+  background: rgb(var(--color-background-alt));
+  font-size: 0.6875rem;
+  text-align: center;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .vault-collection-unfold,
+  .vault-collection-chevron {
+    transition: none;
+  }
+}
