+            }
+            return;
+          }
+          if (current(job)) await openProvider(job);
+        })
+        .catch(() => {
+          if (!current(job)) return;
+          if (cli.isUnlocked()) {
+            fail(job);
+            return;
+          }
+          job.state = "needs_unlock";
+          notify(
+            job,
+            "Private sign-in did not complete. Check your password and current authenticator code, or cancel. No secret output was shared.",
+          );
+        });
+    }
+  };
+  ipcMain.on(CHANNEL, listener);
+  const lockAll = () => {
+    cli.lock();
+    if (active) cleanup(active, "cancelled");
+  };
+  powerMonitor.on("lock-screen", lockAll);
+  powerMonitor.on("suspend", lockAll);
+  app.once("before-quit", () => {
+    powerMonitor.off("lock-screen", lockAll);
+    powerMonitor.off("suspend", lockAll);
+    ipcMain.off(CHANNEL, listener);
+    lockAll();
+  });
+
+  return {
+    async start(
+      key: Key,
+      target: Electron.WebContents,
+      alias: string | VaultAccount | { readonly query: string },
+      authorized: () => boolean = () => true,
+    ): Promise<NativeVaultResult> {
+      if (active) return { state: "busy" };
+      const registry = NodePath.join(NodeOS.homedir(), ".config/osiris-agent-vault/accounts.json");
+      try {
+        let account: VaultAccount | undefined;
+        let query: string | undefined;
+        if (typeof alias === "string") {
