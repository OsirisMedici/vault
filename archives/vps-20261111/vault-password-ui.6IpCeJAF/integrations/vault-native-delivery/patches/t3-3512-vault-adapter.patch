+import { ipcRenderer } from "electron";
+
+const channel = "desktop:private-vault-login";
+window.addEventListener("DOMContentLoaded", () => {
+  document.getElementById("unlock")?.addEventListener("submit", (event) => {
+    event.preventDefault();
+    const password = document.getElementById("password") as HTMLInputElement;
+    const code = document.getElementById("code") as HTMLInputElement;
+    ipcRenderer.send(channel, { action: "unlock", password: password.value, code: code.value });
+    password.value = "";
+    code.value = "";
+  });
+  for (const action of ["approve", "done", "cancel", "lock", "forget"]) {
+    document
+      .getElementById(action)
+      ?.addEventListener("click", () => ipcRenderer.send(channel, { action }));
+  }
+  ipcRenderer.on(channel, (_event, state: { phase: string; message: string }) => {
+    document.getElementById("message")!.textContent = state.message;
+    document.getElementById("approve")!.hidden = state.phase !== "needs_approval";
+    document.getElementById("unlock")!.hidden = state.phase !== "needs_unlock";
+    document.getElementById("done")!.hidden = state.phase !== "private_signin";
+    if (state.phase === "needs_unlock") document.getElementById("password")?.focus();
+  });
+});
