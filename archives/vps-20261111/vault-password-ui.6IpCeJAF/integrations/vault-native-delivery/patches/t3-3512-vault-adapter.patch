+// @effect-diagnostics nodeBuiltinImport:off -- This private main-process adapter owns local sealed storage.
+/* oxlint-disable eslint/preserve-caught-error -- OS and Keychain causes may contain private diagnostics; this boundary exposes fixed errors only. */
+import * as NodeCrypto from "node:crypto";
+import * as NodeFS from "node:fs";
+import * as NodeFSP from "node:fs/promises";
+import * as NodePath from "node:path";
+
+import { safeStorage, systemPreferences } from "electron";
+
+const SERVER = "https://vault.scaleadvertisement.com";
+const OWNER = "businessabhish@gmail.com";
+const MAX_FILE_BYTES = 16 * 1024;
+const MAX_ENCRYPTED_BYTES = 8 * 1024;
+const KEY = /^[A-Za-z0-9+/=]{40,500}$/;
+const FAILED = "vault_device_unlock_failed";
+const CANCELLED = "vault_device_unlock_cancelled";
+const UNAVAILABLE = "vault_device_unlock_unavailable";
+
+function bound(value: unknown): value is Record<string, unknown> {
+  return (
+    typeof value === "object" &&
+    value !== null &&
+    "version" in value &&
+    value.version === 1 &&
+    "server" in value &&
+    value.server === SERVER &&
+    "owner" in value &&
+    value.owner === OWNER
+  );
+}
+
+function ciphertext(bytes: Buffer): Buffer {
+  const value: unknown = JSON.parse(bytes.toString("utf8"));
+  if (
+    !bound(value) ||
+    Object.keys(value).sort().join(",") !== "encrypted,owner,server,version" ||
+    typeof value.encrypted !== "string" ||
+    value.encrypted.length > MAX_ENCRYPTED_BYTES * 2 ||
+    !/^[A-Za-z0-9+/]+={0,2}$/.test(value.encrypted)
+  )
+    throw new Error(FAILED);
+  const encrypted = Buffer.from(value.encrypted, "base64");
+  if (
+    encrypted.length < 16 ||
+    encrypted.length > MAX_ENCRYPTED_BYTES ||
+    encrypted.toString("base64") !== value.encrypted
+  )
+    throw new Error(FAILED);
+  return encrypted;
+}
+
+/**
+ * Same-user workflow protection, not a hardware-enforced biometric Keychain ACL.
+ * The key and this object must remain in the Electron main process.
+ */
+export function createVaultDeviceUnlock(filePath: string) {
+  const path = NodePath.resolve(filePath);
+  const directory = NodePath.dirname(path);
+  let generation = 0;
+  let pending: Promise<unknown> = Promise.resolve();
+
+  const cancel = (): void => {
+    generation++;
+  };
+  const check = (current: number) => {
+    if (current !== generation) throw new Error(CANCELLED);
+  };
+  const supported = (): boolean =>
+    // oxlint-disable-next-line t3code/no-global-process-runtime -- This private adapter supports macOS with an OS user identity only.
+    process.platform === "darwin" && typeof process.getuid === "function";
+  const available = (): boolean => {
+    try {
+      return (
+        supported() && systemPreferences.canPromptTouchID() && safeStorage.isEncryptionAvailable()
+      );
+    } catch {
+      return false;
+    }
+  };
+  const requireAvailable = () => {
+    if (!available()) throw new Error(UNAVAILABLE);
+  };
+  const step = async <T>(operation: Promise<T>, current: number): Promise<T> => {
+    const result = await operation;
+    check(current);
+    return result;
+  };
+  const queue = <T>(
+    operation: (current: number) => Promise<T>,
+    needsEncryption = true,
+  ): Promise<T> => {
+    const current = generation;
+    const result = pending.then(async () => {
+      try {
+        check(current);
+        if (!supported()) throw new Error(UNAVAILABLE);
+        if (needsEncryption) requireAvailable();
+        const value = await operation(current);
+        check(current);
+        return value;
+      } catch {
+        // Neither OS diagnostics nor decrypted payloads may cross this boundary.
+        throw new Error(current !== generation ? CANCELLED : available() ? FAILED : UNAVAILABLE);
+      }
+    });
+    pending = result.catch(() => {});
+    return result;
+  };
+
+  const privateFile = (stat: NodeFS.Stats) => {
+    if (
+      !stat.isFile() ||
+      stat.isSymbolicLink() ||
+      stat.uid !== process.getuid!() ||
+      (stat.mode & 0o7777) !== 0o600 ||
+      stat.nlink !== 1 ||
+      stat.size < 1 ||
+      stat.size > MAX_FILE_BYTES
+    )
+      throw new Error(FAILED);
+  };
+  const sameFile = (left: NodeFS.Stats, right: NodeFS.Stats) => {
+    if (left.dev !== right.dev || left.ino !== right.ino) throw new Error(FAILED);
+  };
+  const inspectDirectory = async (current: number, create = false) => {
+    check(current);
+    const ancestors: string[] = [];
+    let ancestor = NodePath.dirname(directory);
+    for (;;) {
+      ancestors.unshift(ancestor);
+      const parent = NodePath.dirname(ancestor);
+      if (parent === ancestor) break;
+      ancestor = parent;
+    }
+    for (const entry of ancestors) {
+      const stat = await step(NodeFSP.lstat(entry), current);
+      if (!stat.isDirectory() || stat.isSymbolicLink()) throw new Error(FAILED);
+    }
+    if (create) {
+      try {
+        await step(NodeFSP.mkdir(directory, { mode: 0o700 }), current);
+      } catch (error) {
+        check(current);
+        if (!(error instanceof Error) || !("code" in error) || error.code !== "EEXIST")
+          throw new Error(FAILED);
+      }
+    }
+    const stat = await step(NodeFSP.lstat(directory), current);
+    if (
+      !stat.isDirectory() ||
+      stat.isSymbolicLink() ||
+      stat.uid !== process.getuid!() ||
+      (stat.mode & 0o7777) !== 0o700
+    )
+      throw new Error(FAILED);
+  };
+  const readEnrollment = async (current: number) => {
+    await inspectDirectory(current);
+    check(current);
+    const before = await step(NodeFSP.lstat(path), current);
+    privateFile(before);
+    const handle = await NodeFSP.open(
+      path,
+      NodeFS.constants.O_RDONLY | NodeFS.constants.O_NOFOLLOW | NodeFS.constants.O_NONBLOCK,
+    );
+    let bytes: Buffer;
+    try {
+      check(current);
+      const opened = await step(handle.stat(), current);
+      privateFile(opened);
+      sameFile(before, opened);
+      const buffer = Buffer.alloc(MAX_FILE_BYTES + 1);
+      check(current);
+      const { bytesRead } = await step(handle.read(buffer, 0, buffer.length, 0), current);
+      const after = await step(handle.stat(), current);
+      privateFile(after);
+      if (
+        bytesRead !== opened.size ||
+        bytesRead !== after.size ||
+        opened.mtimeMs !== after.mtimeMs ||
+        opened.ctimeMs !== after.ctimeMs
+      )
+        throw new Error(FAILED);
+      bytes = buffer.subarray(0, bytesRead);
+    } finally {
+      await handle.close();
+    }
+    check(current);
+    const linked = await step(NodeFSP.lstat(path), current);
+    privateFile(linked);
+    sameFile(before, linked);
+    return { encrypted: ciphertext(bytes), stat: linked };
+  };
+  const absent = (error: unknown) =>
+    error instanceof Error && "code" in error && error.code === "ENOENT";
+
+  return {
+    available,
+    cancel,
+    async enrolled(): Promise<boolean> {
+      try {
+        return await queue(async (current) => {
+          await readEnrollment(current);
+          check(current);
+          return true;
+        });
+      } catch {
+        return false;
+      }
+    },
+    enroll(key: string): Promise<void> {
+      return queue(async (current) => {
+        if (typeof key !== "string" || !KEY.test(key)) throw new Error(FAILED);
+        await step(systemPreferences.promptTouchID("enable private vault unlock"), current);
+        check(current);
+        requireAvailable();
+        const encrypted = safeStorage.encryptString(
+          JSON.stringify({ version: 1, server: SERVER, owner: OWNER, key }),
+        );
+        check(current);
+        if (encrypted.length < 16 || encrypted.length > MAX_ENCRYPTED_BYTES)
+          throw new Error(FAILED);
+        const bytes = Buffer.from(
+          JSON.stringify({
+            version: 1,
+            server: SERVER,
+            owner: OWNER,
+            encrypted: encrypted.toString("base64"),
+          }),
+        );
+        await inspectDirectory(current, true);
+        check(current);
+        // Refuse to replace an unrelated file, even when it belongs to this OS user.
+        let previous: NodeFS.Stats | undefined;
+        try {
+          previous = (await readEnrollment(current)).stat;
+          check(current);
+        } catch (error) {
+          check(current);
+          if (!absent(error)) throw new Error(FAILED);
+        }
+        const temporary = NodePath.join(
+          directory,
+          `.${NodePath.basename(path)}.${NodeCrypto.randomUUID()}.tmp`,
+        );
+        let ownedTemporary = false;
+        let saved: NodeFS.Stats | undefined;
+        try {
+          check(current);
+          const handle = await NodeFSP.open(
+            temporary,
+            NodeFS.constants.O_CREAT |
+              NodeFS.constants.O_EXCL |
+              NodeFS.constants.O_WRONLY |
+              NodeFS.constants.O_NOFOLLOW,
+            0o600,
+          );
+          ownedTemporary = true;
+          try {
+            check(current);
+            await step(handle.writeFile(bytes), current);
+            saved = await step(handle.stat(), current);
+            privateFile(saved);
+            await step(handle.sync(), current);
+          } finally {
+            await handle.close();
+          }
+          check(current);
+          await inspectDirectory(current);
+          check(current);
+          const source = await step(NodeFSP.lstat(temporary), current);
+          privateFile(source);
+          sameFile(saved!, source);
+          try {
+            const destination = await step(NodeFSP.lstat(path), current);
+            privateFile(destination);
+            if (!previous) throw new Error(FAILED);
+            sameFile(previous, destination);
+          } catch (error) {
+            check(current);
+            if (!absent(error) || previous) throw new Error(FAILED);
+          }
+          check(current);
+          await NodeFSP.rename(temporary, path);
+          ownedTemporary = false;
+          // cancel() can run while rename is pending. Remove only our published inode.
+          check(current);
+        } finally {
+          if (ownedTemporary) await NodeFSP.unlink(temporary).catch(() => {});
+          if (current !== generation && saved) {
+            const linked = await NodeFSP.lstat(path).catch(() => undefined);
+            if (linked && linked.dev === saved.dev && linked.ino === saved.ino)
+              await NodeFSP.unlink(path).catch(() => {});
+          }
+        }
+        check(current);
+      });
+    },
+    restore(): Promise<string> {
+      return queue(async (current) => {
+        // Electron explicitly requires prompting before fetching sensitive bytes.
+        await step(systemPreferences.promptTouchID("unlock the private vault"), current);
+        check(current);
+        requireAvailable();
+        const { encrypted } = await readEnrollment(current);
+        check(current);
+        requireAvailable();
+        const value: unknown = JSON.parse(safeStorage.decryptString(encrypted));
+        check(current);
+        if (
+          !bound(value) ||
+          Object.keys(value).sort().join(",") !== "key,owner,server,version" ||
+          typeof value.key !== "string" ||
+          !KEY.test(value.key)
+        )
+          throw new Error(FAILED);
+        return value.key;
+      });
+    },
+    forget(): Promise<void> {
+      cancel();
+      // Local revocation must work even when biometrics or Keychain access is unavailable.
+      return queue(async (current) => {
+        let enrollment: Awaited<ReturnType<typeof readEnrollment>>;
+        try {
+          enrollment = await readEnrollment(current);
+          check(current);
+        } catch (error) {
+          check(current);
+          if (absent(error)) return;
+          throw new Error(FAILED);
+        }
+        const linked = await step(NodeFSP.lstat(path), current);
+        privateFile(linked);
+        sameFile(enrollment.stat, linked);
+        await step(NodeFSP.unlink(path), current);
+      }, false);
+    },
+  };
+}
