+      const { name, value, sameSite, expirationDate } = cookie;
+      const path = cookie.path ?? "/";
+      const host = cookie.domain.replace(/^\./, "");
+      await job.target.session.cookies.set({
+        url: `https://${host}${path}`,
+        name,
+        value,
+        path,
+        secure: cookie.secure ?? true,
+        httpOnly: cookie.httpOnly ?? false,
+        sameSite,
+        ...(cookie.hostOnly ? {} : { domain: cookie.domain }),
+        ...(expirationDate === undefined ? {} : { expirationDate }),
+      });
+    }
+    if (!current(job)) return;
+    const target = job.target;
+    const account = job.account;
+    const landingUrl = account.landingUrl;
+    // Keep ownership/deadline checks live throughout handoff and verify the
+    // intended account in the actual destination, not merely the private page.
+    await target.loadURL(landingUrl).catch(() => {});
+    if (!current(job)) return;
+    const verified = await target.executeJavaScript(vaultIdentityScript(account)).then(
+      (value) => value === true,
+      () => false,
+    );
+    if (!current(job)) return;
+    cli.lock();
+    cleanup(job, verified ? "signed_in" : "ready_to_verify");
+  };
+
+  const listener = (event: Electron.IpcMainEvent, input: unknown) => {
+    const job = active;
+    if (
+      !job ||
+      event.sender !== job.window.webContents ||
+      event.senderFrame !== job.window.webContents.mainFrame ||
+      !current(job)
+    )
+      return;
+    if (typeof input !== "object" || input === null || !("action" in input)) return;
+    const action = (input as { action: unknown }).action;
+    if (action === "cancel") {
+      cli.lock();
+      cleanup(job, "cancelled");
+      return;
+    }
+    if (action === "lock") {
+      cli.lock();
+      cleanup(job, "cancelled");
+      return;
+    }
+    if (action === "forget") {
+      void cli.forgetDevice().then(
+        () => cleanup(job, "cancelled"),
+        () => fail(job),
+      );
+      return;
+    }
+    if (action === "approve" && job.state === "needs_approval") {
+      void approve(job).catch(() => fail(job));
+    } else if (action === "done") {
+      void finish(job).catch(() => fail(job));
+    } else if (action === "unlock" && job.state === "needs_unlock") {
+      const data = input as { password?: unknown; code?: unknown };
+      if (
+        typeof data.password !== "string" ||
+        !data.password ||
+        data.password.length > 4096 ||
+        (data.code !== undefined && (typeof data.code !== "string" || !/^\d{0,8}$/.test(data.code)))
+      )
+        return;
+      job.state = "unlocking";
+      notify(job, "Unlocking privately…");
+      void cli
+        .unlock(data.password, typeof data.code === "string" ? data.code : undefined)
+        .then(async () => {
+          if (!current(job)) return;
+          try {
+            await cli.enrollDevice();
+          } catch {
+            if (current(job)) {
+              job.state = "needs_approval";
+              notify(
+                job,
+                "Vault sign-in completed, but Touch ID setup did not. Click Use Touch ID to retry your fingerprint without re-entering your password.",
