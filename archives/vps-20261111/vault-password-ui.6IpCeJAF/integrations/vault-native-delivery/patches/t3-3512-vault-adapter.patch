+  const openProvider = async (job: Job) => {
+    if (job.query !== undefined) {
+      const accounts = await cli.searchAccounts(job.query);
+      if (!current(job)) return;
+      job.accounts = accounts;
+      cli.lock();
+      cleanup(job, "accounts_ready");
+      return;
+    }
+    if (!job.account) throw new Error("missing_account");
+    const credential = await cli.credential(job.account);
+    if (!current(job)) return;
+    job.credential = credential;
+    job.state = "private_signin";
+    const bounds = job.window.getContentBounds();
+    job.window.contentView.addChildView(job.page);
+    job.page.setBounds({ x: 0, y: 210, width: bounds.width, height: bounds.height - 210 });
+    notify(
+      job,
+      "Your saved login fills privately. Supported username and password steps continue automatically. Complete website verification below if requested. This window connects only after the intended signed-in identity is verified.",
+    );
