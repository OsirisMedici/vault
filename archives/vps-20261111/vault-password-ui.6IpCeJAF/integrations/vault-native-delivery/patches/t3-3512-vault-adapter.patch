+import { vaultIdentityScript } from "./VaultProviderIdentity.ts";
+
+const CHANNEL = "desktop:private-vault-login";
+const DEADLINE_MS = 10 * 60 * 1000;
+type TabKey = { readonly threadId: string; readonly tabId: string };
+type Key = TabKey & { readonly agentSessionId: string };
+export type VaultMetadata = { itemId: string; name: string; username: string; origins: string[] };
+type NativeVaultResult = VaultLoginResult & { accounts?: VaultMetadata[] };
+type Job = {
+  readonly key: Key;
+  readonly account: VaultAccount | undefined;
+  readonly query: string | undefined;
+  accounts?: VaultMetadata[];
+  readonly target: Electron.WebContents;
+  readonly authorized: () => boolean;
+  readonly window: Electron.BrowserWindow;
+  readonly privateSession: Electron.Session;
+  readonly page: Electron.WebContentsView;
+  state: VaultLoginResult["state"];
+  timer: ReturnType<typeof setTimeout> | undefined;
+  fillTimer: ReturnType<typeof setInterval> | undefined;
+  filling: boolean;
+  credential: { username: string; password: string } | undefined;
+  submittedUsername: boolean;
+  submittedPassword: boolean;
+};
+const idOf = (key: TabKey) => `${key.threadId}\0${key.tabId}`;
+const escapeHtml = (value: string) =>
+  value.replace(
+    /[&<>"']/g,
+    (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char]!,
+  );
+
+// The private window is not a preview tab, has no agent debugger/recording hooks,
+// and uses an isolated, memory-only browser session. Only cookies from the chosen
+// provider are transferred after the human confirms the sign-in. Service workers,
+// page scripts, form contents and network diagnostics never cross to the preview.
+export function createPrivateVaultLogin(preloadPath: string) {
+  const cli = createVaultCli(
+    NodePath.join(app.getPath("userData"), "vault-cli"),
+    createVaultDeviceUnlock(NodePath.join(app.getPath("userData"), "vault-device", "unlock.enc")),
+  );
+  const jobs = new Map<string, Job>();
+  let active: Job | undefined;
+  const result = (job?: Job): NativeVaultResult => ({
+    state: job?.state ?? "idle",
+    ...(job?.state === "accounts_ready" ? { accounts: job.accounts } : {}),
+  });
+  const notify = (job: Job, message: string) => {
+    if (!job.window.isDestroyed())
+      job.window.webContents.send(CHANNEL, { phase: job.state, message });
+  };
+  const current = (job: Job) =>
+    active === job && job.authorized() && !job.window.isDestroyed() && !job.target.isDestroyed();
+  const cleanup = (job: Job, state: VaultLoginResult["state"]) => {
+    job.state = state;
+    job.credential = undefined;
+    clearTimeout(job.timer);
+    clearInterval(job.fillTimer);
+    if (active === job) active = undefined;
+    if (!job.page.webContents.isDestroyed()) job.page.webContents.close();
+    if (!job.window.isDestroyed()) job.window.destroy();
+    void job.privateSession.clearStorageData().catch(() => {});
+  };
+  const revoke = (key: TabKey) => {
+    const job = jobs.get(idOf(key));
+    if (job && active === job) {
+      cli.lock();
+      cleanup(job, "cancelled");
+    }
+  };
+  const fail = (job: Job) => {
+    // A rejected callback from a cancelled job cannot lock a newer request.
+    if (active !== job) return;
+    cli.lock();
+    // No underlying exception, CLI output, page payload, or form value is returned.
+    cleanup(job, "failed");
+  };
+
+  const providerReady = async (job: Job) => {
+    if (!job.account || !reachedVaultProvider(job.page.webContents.getURL(), job.account))
+      return false;
+    return job.page.webContents.executeJavaScript(vaultIdentityScript(job.account)).then(
+      (value) => value === true,
+      () => false,
+    );
+  };
