@@ -0,0 +1,124 @@
+import { describe, expect, it } from "vite-plus/test";
+import {
+  credentialForAccount,
+  mayFillVaultPassword,
+  mayNavigateVaultProvider,
+  mayTransferVaultCookie,
+  readVaultAccount,
+} from "./VaultLoginPolicy.ts";
+
+const alias = "gmail-fixture";
+const record = {
+  alias,
+  service: "gmail",
+  username: "fixture@example.com",
+  vaultItemId: "11111111-1111-4111-8111-111111111111",
+  passwordStored: true,
+  allowedOrigins: ["https://accounts.google.com"],
+  loginUrl: "https://accounts.google.com/ServiceLogin?service=mail",
+};
+const directory = { accounts: { [alias]: record } };
+const account = () => readVaultAccount(directory, alias);
+const item = () => ({
+  id: record.vaultItemId,
+  type: 1,
+  reprompt: 0,
+  login: {
+    username: record.username,
+    password: "sentinel-fixture-only",
+    uris: [{ uri: record.allowedOrigins[0] }],
+  },
+});
+
+describe("private Vault sign-in policy", () => {
+  it("accepts an exact HTTPS login origin and rejects misleading origins", () => {
+    const target = account();
+    expect(mayFillVaultPassword("https://accounts.google.com/signin", target)).toBe(true);
+    for (const url of [
+      "http://accounts.google.com/",
+      "https://accounts.google.com.evil.test/",
+      "https://accounts.google.com:8443/",
+      "https://evil.test/accounts.google.com",
+      "https://accounts.google.com@evil.test/",
+      "https://user:pass@accounts.google.com/",
+      "data:text/html,test",
+      "not a URL",
+      "https://accounts.google.com/signin/recovery/",
+      "https://accounts.google.com/signup/",
+    ])
+      expect(mayFillVaultPassword(url, target)).toBe(false);
+  });
+
+  it("restricts private navigation to HTTPS provider domains without URL credentials", () => {
+    for (const url of [
+      "https://accounts.google.com/signin",
+      "https://mail.google.com/mail/u/0/",
+      "https://google.com/",
+    ])
+      expect(mayNavigateVaultProvider(url, account())).toBe(true);
+    for (const url of [
+      "http://accounts.google.com/",
+      "https://google.com.evil.test/",
+      "https://evilgoogle.com/",
+      "https://godaddy.com/",
+      "https://user:pass@accounts.google.com/",
+      "https://accounts.google.com:8443/",
+      "data:text/html,test",
+    ])
+      expect(mayNavigateVaultProvider(url, account())).toBe(false);
+  });
+
+  it("cannot redirect a registered credential by editing the public metadata", () => {
+    for (const change of [
+      { allowedOrigins: ["https://evil.test"] },
+      { allowedOrigins: [...record.allowedOrigins, "https://evil.test"] },
+      { loginUrl: "https://evil.test" },
+      { service: "arbitrary" },
+      { vaultItemId: "not-a-uuid" },
+      { passwordStored: false },
+    ])
+      expect(() =>
+        readVaultAccount({ accounts: { [alias]: { ...record, ...change } } }, alias),
+      ).toThrow();
+    expect(() => readVaultAccount(directory, "__proto__")).toThrow();
+    expect(() => readVaultAccount(directory, "missing-account")).toThrow();
+  });
+
+  it("requires the registered item and identity, never another stored account", () => {
+    const target = account();
+    expect(credentialForAccount(item(), target).username).toBe(record.username);
+    for (const change of [
+      { id: "22222222-2222-4222-8222-222222222222" },
+      { type: 2 },
+      { reprompt: 1 },
+      { deletedDate: "2026-10-22" },
+      { login: { ...item().login, username: "someone-else@example.com" } },
+      { login: { ...item().login, password: "" } },
+      { login: { ...item().login, uris: [{ uri: "https://evil.test" }] } },
+    ])
+      expect(() => credentialForAccount({ ...item(), ...change }, target)).toThrow();
+  });
+
+  it("never includes decrypted payloads in failure messages", () => {
+    const input = item();
+    input.login.username = "wrong@example.com";
+    try {
+      credentialForAccount(input, account());
+    } catch (error) {
+      expect(String(error)).not.toContain("sentinel-fixture-only");
+      expect(String(error)).not.toContain("wrong@example.com");
+    }
+  });
+
+  it("transfers only cookies belonging to the selected provider", () => {
+    for (const domain of ["google.com", ".google.com", "accounts.google.com", ".mail.google.com"])
+      expect(mayTransferVaultCookie(domain, account())).toBe(true);
+    for (const domain of [
+      "evilgoogle.com",
+      "google.com.evil.test",
+      "godaddy.com",
+      "vault.scaleadvertisement.com",
+    ])
+      expect(mayTransferVaultCookie(domain, account())).toBe(false);
+  });
+});
diff --git a/apps/desktop/src/preview/VaultLoginPolicy.ts b/apps/desktop/src/preview/VaultLoginPolicy.ts
new file mode 100644
index 000000000..950374ea6
--- /dev/null
+++ b/apps/desktop/src/preview/VaultLoginPolicy.ts
@@ -0,0 +1,169 @@
+/** Public routing metadata only. Never infer permission from a vault URI. */
+export interface VaultAccount {
+  readonly alias: string;
+  readonly username: string;
+  readonly vaultItemId: string;
+  readonly service: "gmail" | "godaddy";
+  readonly origin: string;
+  readonly loginUrl: string;
+  readonly landingUrl: string;
+  readonly cookieDomain: string;
+}
+
+const services = {
+  gmail: {
+    origin: "https://accounts.google.com",
+    loginUrl: "https://accounts.google.com/ServiceLogin?service=mail",
+    landingUrl: "https://mail.google.com/",
+    cookieDomain: "google.com",
+  },
+  godaddy: {
+    origin: "https://sso.godaddy.com",
+    loginUrl: "https://sso.godaddy.com/",
+    landingUrl: "https://account.godaddy.com/",
+    cookieDomain: "godaddy.com",
+  },
+} as const;
+
+export interface VaultAccountMetadata {
+  readonly itemId: string;
+  readonly name: string;
+  readonly username: string;
+  readonly origins: readonly string[];
+}
+
+/** Metadata is a selection aid. Only reviewed provider adapters grant fill. */
+export function accountFromMetadata(item: VaultAccountMetadata): VaultAccount | undefined {
+  if (
+    !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(item.itemId) ||
+    !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(item.username)
+  )
+    return undefined;
+  const service = item.origins.includes(services.godaddy.origin)
+    ? "godaddy"
+    : item.origins.includes(services.gmail.origin)
+      ? "gmail"
+      : undefined;
+  if (!service) return undefined;
+  return {
+    alias: "selected-account",
+    vaultItemId: item.itemId,
+    username: item.username,
+    service,
+    ...services[service],
+  };
+}
+
+export function readVaultAccount(directory: unknown, alias: string): VaultAccount {
+  if (typeof directory !== "object" || directory === null || !("accounts" in directory))
+    throw new Error("invalid_directory");
+  const accounts = directory.accounts;
+  if (typeof accounts !== "object" || accounts === null || !Object.hasOwn(accounts, alias))
+    throw new Error("unknown_account");
+  const entry = (accounts as Record<string, unknown>)[alias];
+  if (typeof entry !== "object" || entry === null) throw new Error("invalid_account");
+  const record = entry as Record<string, unknown>;
+  if (
+    record.alias !== alias ||
+    (record.service !== "gmail" && record.service !== "godaddy") ||
+    typeof record.username !== "string" ||
+    !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(record.username) ||
+    [...record.username].some((char) => char.charCodeAt(0) < 32 || char.charCodeAt(0) === 127) ||
+    typeof record.vaultItemId !== "string" ||
+    !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(record.vaultItemId) ||
+    record.passwordStored !== true
+  )
+    throw new Error("invalid_account");
+  const route = services[record.service];
+  if (
+    record.loginUrl !== route.loginUrl ||
+    !Array.isArray(record.allowedOrigins) ||
+    record.allowedOrigins.length !== 1 ||
+    record.allowedOrigins[0] !== route.origin
+  )
+    throw new Error("invalid_origin");
+  return {
+    alias,
+    username: record.username,
+    vaultItemId: record.vaultItemId,
+    service: record.service,
+    ...route,
+  };
+}
+
+export function mayNavigateVaultProvider(url: string, account: VaultAccount): boolean {
+  try {
+    const parsed = new URL(url);
+    return (
+      parsed.protocol === "https:" &&
+      !parsed.username &&
+      !parsed.password &&
+      !parsed.port &&
+      mayTransferVaultCookie(parsed.hostname, account)
+    );
+  } catch {
+    return false;
+  }
+}
+
+export function mayFillVaultPassword(url: string, account: VaultAccount): boolean {
+  try {
+    const parsed = new URL(url);
+    const changesCredentials =
+      /(?:^|\/)(?:signup|sign-up|createaccount|recovery|recover|reset|resetpassword|changepassword)(?:\/|$)/i.test(
+        parsed.pathname,
+      );
+    return (
+      parsed.origin === account.origin &&
+      !parsed.username &&
+      !parsed.password &&
+      !changesCredentials
+    );
+  } catch {
+    return false;
+  }
+}
+
+export function mayTransferVaultCookie(domain: string, account: VaultAccount): boolean {
+  const host = domain.replace(/^\./, "").toLowerCase();
+  return host === account.cookieDomain || host.endsWith(`.${account.cookieDomain}`);
+}
+
+export function reachedVaultProvider(url: string, account: VaultAccount): boolean {
+  try {
+    const parsed = new URL(url);
+    return (
+      parsed.origin === new URL(account.landingUrl).origin && !parsed.username && !parsed.password
+    );
+  } catch {
+    return false;
+  }
+}
+
+/** Reconstruct, rather than forward, the decrypted CLI response. */
+export function credentialForAccount(item: unknown, account: VaultAccount) {
+  if (typeof item !== "object" || item === null) throw new Error("invalid_item");
+  const value = item as Record<string, unknown>;
+  const login = value.login as Record<string, unknown> | undefined;
+  if (
+    value.id !== account.vaultItemId ||
+    value.type !== 1 ||
+    value.deletedDate ||
+    value.reprompt === 1 ||
+    login?.username !== account.username ||
+    typeof login.password !== "string" ||
+    login.password.length === 0 ||
+    !Array.isArray(login.uris) ||
+    !login.uris.some((entry: { uri?: unknown }) => {
+      if (typeof entry?.uri !== "string") return false;
+      try {
+        const uri = new URL(entry.uri);
+        return uri.origin === account.origin && !uri.username && !uri.password && !uri.port;
+      } catch {
+        return false;
+      }
+    })
+  )
+    throw new Error("item_mismatch");
+  return { username: account.username, password: login.password };
+}
diff --git a/apps/desktop/src/preview/VaultMcpBridge.test.ts b/apps/desktop/src/preview/VaultMcpBridge.test.ts
new file mode 100644
index 000000000..a75ad85eb
--- /dev/null
+++ b/apps/desktop/src/preview/VaultMcpBridge.test.ts
@@ -0,0 +1,74 @@
+// @effect-diagnostics nodeBuiltinImport:off -- Real Unix sockets and a captured child in private temporary test directories only.
+import * as NodeFSP from "node:fs/promises";
+import * as NodeNet from "node:net";
+import * as NodeChildProcess from "node:child_process";
+import { describe, expect, it, vi } from "vite-plus/test";
+vi.mock("electron", () => ({ app: { once: vi.fn() } }));
+import { startVaultMcpBridge, removeStaleVaultSocket } from "./VaultMcpBridge.ts";
+
+function event(emitter: NodeJS.EventEmitter, name: string): Promise<unknown[]> {
+  return new Promise((resolve) => emitter.once(name, (...args: unknown[]) => resolve(args)));
+}
+
+describe("Vault native socket lifecycle", () => {
+  it("uses private socket modes, cancels disconnected clients, refuses live peers and restarts after ordinary close", async () => {
+    const directory = await NodeFSP.mkdtemp("/tmp/vault-bridge-");
+    const socketPath = `${directory}/broker.sock`;
+    const disconnected = Promise.withResolvers<void>();
+    const handler = {
+      call: async () => ({ state: "idle" }),
+      disconnect: vi.fn(() => disconnected.resolve()),
+    };
+    let bridge;
+    try {
+      bridge = await startVaultMcpBridge(handler, socketPath);
+      expect((await NodeFSP.lstat(socketPath)).mode & 0o777).toBe(0o600);
+      const client = NodeNet.createConnection(socketPath);
+      await event(client, "connect");
+      const response = event(client, "data");
+      client.write(JSON.stringify({ id: "fixture", action: "connection" }) + "\n");
+      expect(JSON.parse(String((await response)[0]))).toEqual({
+        id: "fixture",
+        result: { state: "idle" },
+      });
+      client.destroy();
+      await disconnected.promise;
+      expect(handler.disconnect).toHaveBeenCalledOnce();
+      await expect(startVaultMcpBridge(handler, socketPath)).rejects.toThrow(
+        "bridge_socket_active_or_unknown",
+      );
+      await bridge.close();
+      bridge = await startVaultMcpBridge(handler, socketPath);
+      expect((await NodeFSP.lstat(socketPath)).isSocket()).toBe(true);
+    } finally {
+      await bridge?.close();
+      await NodeFSP.rm(directory, { recursive: true, force: true });
+    }
+  });
+
+  it("recovers only an owned refused socket after a captured fixture process crashes", async () => {
+    const directory = await NodeFSP.mkdtemp("/tmp/vault-stale-");
+    const path = `${directory}/broker.sock`;
+    const child = NodeChildProcess.spawn(
+      process.execPath,
+      [
+        "-e",
+        "const fs=require('node:fs'),net=require('node:net');net.createServer().listen(process.argv[1],()=>{fs.chmodSync(process.argv[1],0o600);process.stdout.write('ready')})",
+        path,
+      ],
+      { stdio: ["ignore", "pipe", "pipe"] },
+    );
+    try {
+      await event(child.stdout!, "data");
+      const ended = event(child, "close");
+      child.kill("SIGKILL");
+      await ended;
+      expect((await NodeFSP.lstat(path)).isSocket()).toBe(true);
+      await removeStaleVaultSocket(path);
+      await expect(NodeFSP.lstat(path)).rejects.toMatchObject({ code: "ENOENT" });
+    } finally {
+      if (child.exitCode === null && child.signalCode === null) child.kill();
+      await NodeFSP.rm(directory, { recursive: true, force: true });
+    }
+  });
+});
diff --git a/apps/desktop/src/preview/VaultMcpBridge.ts b/apps/desktop/src/preview/VaultMcpBridge.ts
new file mode 100644
index 000000000..16bbc59eb
--- /dev/null
+++ b/apps/desktop/src/preview/VaultMcpBridge.ts
@@ -0,0 +1,173 @@
+// @effect-diagnostics nodeBuiltinImport:off -- Local native socket transport, never a network or browser endpoint.
+import { app } from "electron";
+import * as NodeCrypto from "node:crypto";
+import * as NodeNet from "node:net";
+import * as NodeFSP from "node:fs/promises";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+
+/** Recover only a refused, private, owned socket whose inode is unchanged. */
+export async function removeStaleVaultSocket(socketPath: string) {
+  const before = await NodeFSP.lstat(socketPath);
+  if (
+    !before.isSocket() ||
+    before.isSymbolicLink() ||
+    before.uid !== NodeOS.userInfo().uid ||
+    (before.mode & 0o077) !== 0
+  )
+    throw new Error("untrusted_bridge_socket");
+  const refused = await new Promise<boolean>((resolve) => {
+    const probe = NodeNet.createConnection(socketPath);
+    probe.once("connect", () => {
+      probe.destroy();
+      resolve(false);
+    });
+    probe.once("error", (error) => {
+      probe.destroy();
+      resolve((error as NodeJS.ErrnoException).code === "ECONNREFUSED");
+    });
+    probe.setTimeout(1000, () => {
+      probe.destroy();
+      resolve(false);
+    });
+  });
+  if (!refused) throw new Error("bridge_socket_active_or_unknown");
+  const after = await NodeFSP.lstat(socketPath);
+  if (
+    after.ino !== before.ino ||
+    after.dev !== before.dev ||
+    !after.isSocket() ||
+    after.uid !== before.uid ||
+    (after.mode & 0o077) !== 0
+  )
+    throw new Error("bridge_socket_changed");
+  await NodeFSP.unlink(socketPath);
+}
+
+/** Same-user capability boundary, not isolation from an unrestricted local agent.
+ * No HTTP/CORS, no credentials in this protocol, no private browser/CDP exposure. */
+export async function startVaultMcpBridge(
+  handler: {
+    call(client: string, input: unknown): Promise<Record<string, unknown>>;
+    disconnect(client: string): void;
+  },
+  socketPath = NodePath.join(NodeOS.homedir(), ".config/osiris-agent-vault/run/t3-vault.sock"),
+) {
+  const directory = NodePath.dirname(socketPath);
+  await NodeFSP.mkdir(directory, { recursive: true, mode: 0o700 });
+  const parent = await NodeFSP.lstat(directory);
+  if (
+    !parent.isDirectory() ||
+    parent.isSymbolicLink() ||
+    parent.uid !== NodeOS.userInfo().uid ||
+    (parent.mode & 0o077) !== 0
+  )
+    throw new Error("untrusted_bridge_directory");
+  const clients = new Set<NodeNet.Socket>();
+  const server = NodeNet.createServer((socket) => {
+    if (clients.size >= 8) {
+      socket.destroy();
+      return;
+    }
+    clients.add(socket);
+    const client = NodeCrypto.randomUUID();
+    let buffer = "";
+    let inFlight = false;
+    socket.setEncoding("utf8");
+    socket.on("error", () => socket.destroy());
+    socket.on("close", () => {
+      clients.delete(socket);
+      handler.disconnect(client);
+    });
+    socket.on("data", (chunk) => {
+      buffer += chunk;
+      if (buffer.length > 8192) {
+        socket.destroy();
+        return;
+      }
+      let end: number;
+      while ((end = buffer.indexOf("\n")) >= 0) {
+        const line = buffer.slice(0, end);
+        buffer = buffer.slice(end + 1);
+        let input: unknown;
+        try {
+          input = JSON.parse(line);
+        } catch {
+          socket.destroy();
+          return;
+        }
+        if (!input || typeof input !== "object") {
+          socket.destroy();
+          return;
+        }
+        const data = input as Record<string, unknown>;
+        const keys = new Set([
+          "id",
+          "action",
+          "threadId",
+          "tabId",
+          "query",
+          "requestId",
+          "selectionId",
+        ]);
+        if (
+          typeof data.id !== "string" ||
+          data.id.length > 80 ||
+          Object.keys(data).some((key) => !keys.has(key))
+        ) {
+          socket.destroy();
+          return;
+        }
+        const id = data.id;
+        if (inFlight) {
+          socket.write(JSON.stringify({ id, result: { state: "busy" } }) + "\n");
+          continue;
+        }
+        inFlight = true;
+        void handler
+          .call(client, data)
+          .then(
+            (result) => {
+              if (!socket.destroyed) socket.write(JSON.stringify({ id, result }) + "\n");
+            },
+            () => {
+              if (!socket.destroyed)
+                socket.write(JSON.stringify({ id, result: { state: "failed" } }) + "\n");
+            },
+          )
+          .finally(() => {
+            inFlight = false;
+          });
+      }
+    });
+  });
+  const listen = () =>
+    new Promise<void>((resolve, reject) => {
+      server.once("error", reject);
+      server.listen(socketPath, () => {
+        server.off("error", reject);
+        resolve();
+      });
+    });
+  try {
+    await listen();
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== "EADDRINUSE") throw error;
+    await removeStaleVaultSocket(socketPath);
+    await listen();
+  }
+  await NodeFSP.chmod(socketPath, 0o600);
+  const identity = await NodeFSP.lstat(socketPath);
+  const close = async () => {
+    for (const client of clients) client.destroy();
+    server.close();
+    try {
+      const stat = await NodeFSP.lstat(socketPath);
+      if (stat.ino === identity.ino && stat.dev === identity.dev) await NodeFSP.unlink(socketPath);
+    } catch {
+      /* Already removed; no fallback path. */
+    }
+  };
+  app.once("before-quit", () => void close());
+  return { close };
+}
