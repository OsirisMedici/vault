+            !stat.isFile() ||
+            stat.isSymbolicLink() ||
+            (stat.mode & 0o077) !== 0 ||
+            stat.uid !== NodeOS.userInfo().uid
+          )
+            return { state: "denied" };
+          account = readVaultAccount(JSON.parse(await NodeFSP.readFile(registry, "utf8")), alias);
+        } else if ("query" in alias) {
+          query = alias.query.trim();
+          if (
+            !query ||
+            query.length > 200 ||
+            [...query].some((char) => char.charCodeAt(0) < 32 || char.charCodeAt(0) === 127)
+          )
+            return { state: "denied" };
+        } else account = alias;
+        if (
+          !authorized() ||
+          target.isDestroyed() ||
+          (account !== undefined && !mayFillVaultPassword(target.getURL(), account))
+        )
+          return { state: "denied" };
+        // Re-check after filesystem I/O so simultaneous requests cannot race.
+        if (active) return { state: "busy" };
+        const privateSession = electronSession.fromPartition(
+          `vault-private-${NodeCrypto.randomUUID()}`,
+        );
+        privateSession.setPermissionRequestHandler((_contents, _permission, callback) =>
+          callback(false),
+        );
+        privateSession.on("will-download", (event) => event.preventDefault());
+        const window = new BrowserWindow({
+          width: 1000,
+          height: 850,
+          title: "Vault • Private sign-in",
+          show: false,
+          backgroundColor: "#171717",
+          autoHideMenuBar: true,
+          webPreferences: {
+            sandbox: true,
+            contextIsolation: true,
+            nodeIntegration: false,
+            devTools: false,
+            partition: `vault-control-${NodeCrypto.randomUUID()}`,
+            preload: preloadPath,
+          },
+        });
+        window.setContentProtection(true);
+        window.webContents.setWindowOpenHandler(() => ({ action: "deny" }));
+        window.webContents.on("will-navigate", (event) => event.preventDefault());
+        const page = new WebContentsView({
+          webPreferences: {
+            session: privateSession,
+            sandbox: true,
+            contextIsolation: true,
+            nodeIntegration: false,
+            devTools: false,
+          },
+        });
