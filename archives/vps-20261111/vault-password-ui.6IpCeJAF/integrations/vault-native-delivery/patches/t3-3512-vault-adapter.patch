+        if (user && !user.dataset.vaultFilled && ${!job.submittedUsername}) { set(user, ${JSON.stringify(username)}); user.dataset.vaultFilled = '1'; }
+        const pass = [...document.querySelectorAll('input[type="password"]:not([autocomplete="new-password"])')].find(visible);
+        if (pass && !pass.dataset.vaultFilled && ${!job.submittedPassword}) { set(pass, ${JSON.stringify(password)}); pass.dataset.vaultFilled = '1'; }
+        if (${job.account.service === "gmail"}) {
+          const nextUser = document.querySelector('#identifierNext button');
+          if (visible(user) && visible(nextUser) && user.value === ${JSON.stringify(username)} && ${!job.submittedUsername}) {
+            nextUser.click(); return 'username_submitted';
+          }
+          const nextPass = document.querySelector('#passwordNext button');
+          if (visible(pass) && visible(nextPass) && pass.value === ${JSON.stringify(password)} && ${!job.submittedPassword}) {
+            nextPass.click(); return 'password_submitted';
+          }
+        }
+        if (${job.account.service === "godaddy"} && ${!job.submittedPassword}) {
+          const submit = document.querySelector('#submitBtn');
+          if (visible(user) && visible(pass) && visible(submit) && user.value === ${JSON.stringify(username)} && pass.value === ${JSON.stringify(password)}) {
+            submit.click(); return 'password_submitted';
+          }
+        }
+        return 'waiting';
+      })()`,
+        true,
+      );
+      if (step === "username_submitted") job.submittedUsername = true;
+      if (step === "password_submitted") {
+        job.submittedPassword = true;
+        job.credential = undefined;
+      }
+    } catch {
+      // A navigation invalidates a frame. It must never expose its exception text.
+    } finally {
+      job.filling = false;
+    }
+  };
