+import type { VaultAccount } from "./VaultLoginPolicy.ts";
+
+/** Returns a boolean only. Never read cookies, token stores or whole page data.
+ * GoDaddy's public utility-header exposes shopperData(callback); its username
+ * is the account identity, whereas a profile contact email may belong elsewhere.
+ * Missing/changed provider APIs fail closed and require adapter review. */
+export function vaultIdentityScript(account: VaultAccount): string {
+  const expected = JSON.stringify(account.username.toLowerCase());
+  if (account.service === "gmail")
+    return `(() => {
+    if (location.origin !== 'https://mail.google.com' || !document.querySelector('[role="main"]')) return false;
+    const expected = ${expected};
+    return [...document.querySelectorAll('a[href*="accounts.google.com/SignOutOptions"]')].some(e =>
+      ((e.getAttribute('aria-label') || '') + ' ' + (e.getAttribute('title') || '')).toLowerCase().split(/[\\s(),<>]+/).includes(expected));
+  })()`;
+  return `(() => {
+    if (location.origin !== 'https://account.godaddy.com') return false;
+    // Provider-owned account metadata API, observed in GoDaddy's public
+    // utility-header source. No storage/cookie/session access or data return.
+    const api = window.ux?.shopperData;
+    if (typeof api !== 'function') return false;
+    return new Promise(resolve => {
+      const timer = setTimeout(() => resolve(false), 3000);
+      try { api((error, data) => {
+        clearTimeout(timer);
+        const name = data?.username;
+        resolve(!error && typeof name === 'string' && name.toLowerCase() === ${expected} && typeof data.shopperId === 'string' && data.shopperId.length > 0);
+      }); } catch { clearTimeout(timer); resolve(false); }
+    });
+  })()`;
+}
