+        const navigation = (event: Electron.Event, url: string) => {
+          if (account && mayNavigateVaultProvider(url, account)) return;
+          event.preventDefault();
+          cli.lock();
+          fail(job);
+        };
+        page.webContents.on("will-navigate", navigation);
+        page.webContents.on("will-redirect", navigation);
+        const job: Job = {
+          key,
+          account,
+          query,
+          target,
+          authorized,
+          window,
+          privateSession,
+          page,
+          state: "needs_approval",
+          filling: false,
+          submittedUsername: false,
+          submittedPassword: false,
+          credential: undefined,
+          timer: undefined,
+          fillTimer: undefined,
+        };
+        jobs.set(idOf(key), job);
+        active = job;
+        job.timer = setTimeout(() => {
+          cli.lock();
+          cleanup(job, "expired");
+        }, DEADLINE_MS);
+        window.on("close", () => {
+          if (active === job) cli.lock();
+          cleanup(
+            job,
+            ["ready_to_verify", "signed_in", "accounts_ready"].includes(job.state)
+              ? job.state
+              : "cancelled",
+          );
+        });
+        window.on("resize", () => {
+          const b = window.getContentBounds();
+          page.setBounds({ x: 0, y: 210, width: b.width, height: Math.max(1, b.height - 210) });
+        });
+        window.webContents.once("did-finish-load", () =>
+          notify(
+            job,
+            account
+              ? `Allow this thread to sign in to ${account.service} as ${account.username}? This grants browser access to that account. Thread: ${key.threadId}`
+              : `Allow this thread to search saved account metadata for "${query}"? Names, usernames and website origins will be shared. No passwords. Requester label: ${key.threadId}. Confirm this is the intended T3 tab.`,
+          ),
+        );
+        const html = `<!doctype html><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; form-action 'none'"><style>body{font:14px system-ui;background:#171717;color:#eee;padding:20px;margin:0}h1{font-size:20px;margin:0 0 10px}p{max-width:900px;line-height:1.4}input,button{font:inherit;padding:9px;border-radius:6px;border:1px solid #555;margin:3px;background:#292929;color:#eee}button{cursor:pointer}small{color:#bbb}[hidden]{display:none!important}</style><h1>Vault • Private sign-in</h1><small>${escapeHtml(account ? account.username + " · " + account.origin : "Account search: " + query)}</small><p id="message">Confirm this account connection.</p><button id="approve">Use Touch ID to sign in</button><form id="unlock" hidden><input id="password" type="password" placeholder="Vault master password" autocomplete="off" required aria-label="Vault master password"><input id="code" type="password" inputmode="numeric" placeholder="Authenticator code if required" autocomplete="off" aria-label="Authenticator code"><button>Enable Touch ID on this Mac</button></form><button id="done" hidden>Finished. Connect this account</button><button id="cancel">Cancel</button><button id="lock">Lock Vault</button><button id="forget">Remove this Mac's saved connection</button>`;
+        await window.loadURL(`data:text/html;charset=utf-8,${encodeURIComponent(html)}`);
+        if (current(job)) {
+          window.show();
+          window.focus();
+        }
+        return result(job);
+      } catch {
+        if (active?.key === key) fail(active);
+        return { state: "failed" };
+      }
+    },
+    status: (key: Key): NativeVaultResult => {
+      const job = jobs.get(idOf(key));
+      return job && job.key.agentSessionId !== key.agentSessionId
+        ? { state: "denied" }
+        : result(job);
+    },
+    cancel(key: Key): VaultLoginResult {
+      const job = jobs.get(idOf(key));
+      if (job && job.key.agentSessionId !== key.agentSessionId) return { state: "denied" };
+      if (job) {
+        if (active === job) cli.lock();
+        cleanup(job, "cancelled");
+      }
+      return result(job);
+    },
+    revoke,
+    detach(key: TabKey) {
+      revoke(key);
+      jobs.delete(idOf(key));
+    },
+  };
+}
