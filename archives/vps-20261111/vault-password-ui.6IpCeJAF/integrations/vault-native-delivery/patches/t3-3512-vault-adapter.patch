+// @effect-diagnostics nodeBuiltinImport:off -- Execute boolean-only identity checks against harmless page fixtures.
+import * as NodeVM from "node:vm";
+import { describe, expect, it } from "vite-plus/test";
+import { readVaultAccount } from "./VaultLoginPolicy.ts";
+import { vaultIdentityScript } from "./VaultProviderIdentity.ts";
+
+const username = "fixture@example.com";
+const account = readVaultAccount(
+  {
+    accounts: {
+      fixture: {
+        alias: "fixture",
+        username,
+        service: "godaddy",
+        vaultItemId: "11111111-1111-4111-8111-111111111111",
+        passwordStored: true,
+        loginUrl: "https://sso.godaddy.com/",
+        allowedOrigins: ["https://sso.godaddy.com"],
+      },
+    },
+  },
+  "fixture",
+);
+
+describe("GoDaddy exact account verifier", () => {
+  it("accepts only matching provider username and authenticated shopper metadata on the account origin", async () => {
+    const evaluate = (
+      name: string,
+      origin = "https://account.godaddy.com",
+      shopperId = "fixture-shopper",
+    ) =>
+      NodeVM.runInNewContext(vaultIdentityScript(account), {
+        location: { origin },
+        window: {
+          ux: {
+            shopperData: (done: (error: unknown, data: unknown) => void) =>
+              done(null, { username: name, shopperId, password: "SENTINEL_NOT_RETURNED" }),
+          },
+        },
+        setTimeout: () => 1,
+        clearTimeout: () => {},
+      });
+    expect(await evaluate(username)).toBe(true);
+    expect(await evaluate("wrong@example.com")).toBe(false);
+    expect(await evaluate(username, "https://account.godaddy.com.evil.test")).toBe(false);
+    expect(await evaluate(username, "https://account.godaddy.com", "")).toBe(false);
+    expect(
+      await NodeVM.runInNewContext(vaultIdentityScript(account), {
+        location: { origin: "https://account.godaddy.com" },
+        window: {},
+      }),
+    ).toBe(false);
+  });
+});
