+    if (!current(job)) return;
+    await fill(job);
+    job.fillTimer = setInterval(() => void fill(job), 1000);
+  };
+
+  const approve = async (job: Job) => {
+    job.state = "unlocking";
+    notify(job, "Approve with Touch ID to use this saved account…");
+    if (!cli.deviceAvailable()) {
+      job.state = "needs_approval";
+      notify(
+        job,
+        "Touch ID or Keychain encryption is unavailable. Access remains locked. No password fallback was started.",
+      );
+      return;
+    }
