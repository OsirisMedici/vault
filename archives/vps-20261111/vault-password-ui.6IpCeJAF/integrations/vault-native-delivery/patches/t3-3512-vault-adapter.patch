@@ -0,0 +1,162 @@
+import { describe, expect, it, vi } from "vite-plus/test";
+import { createVaultConnection } from "./VaultConnection.ts";
+import type { createPrivateVaultLogin } from "./PrivateVaultLogin.ts";
+
+function setup() {
+  let authorized = true;
+  let state = "needs_approval";
+  const items = [
+    {
+      itemId: "11111111-1111-4111-8111-111111111111",
+      name: "GoDaddy A",
+      username: "a@example.com",
+      origins: ["https://sso.godaddy.com"],
+    },
+    {
+      itemId: "22222222-2222-4222-8222-222222222222",
+      name: "GoDaddy B",
+      username: "b@example.com",
+      origins: ["https://sso.godaddy.com"],
+    },
+    {
+      itemId: "33333333-3333-4333-8333-333333333333",
+      name: "Slack",
+      username: "a@example.com",
+      origins: ["https://slack.com"],
+    },
+  ];
+  const vault = {
+    start: vi.fn(async () => ({ state: "needs_approval" })),
+    status: vi.fn(() => ({ state, accounts: items })),
+    cancel: vi.fn(() => ({ state: "cancelled" })),
+  };
+  const target = { loadURL: vi.fn(async () => {}) };
+  const connection = createVaultConnection({
+    getVault: async () => vault as unknown as ReturnType<typeof createPrivateVaultLogin>,
+    getTab: () => ({
+      target: target as unknown as Electron.WebContents,
+      authorized: () => authorized,
+    }),
+  });
+  const search = () =>
+    connection.call("client", {
+      action: "search",
+      threadId: "thread",
+      tabId: "tab",
+      query: "GoDaddy",
+    });
+  return {
+    connection,
+    vault,
+    target,
+    search,
+    approveSearch: () => {
+      state = "accounts_ready";
+    },
+    revoke: () => {
+      authorized = false;
+    },
+  };
+}
+
+describe("persistent Vault native connection", () => {
+  it("cancels a pending native start immediately on disconnect and drops its late result", async () => {
+    const f = setup();
+    const started = Promise.withResolvers<void>();
+    const pending = Promise.withResolvers<{ state: string }>();
+    f.vault.start.mockImplementation(() => {
+      started.resolve();
+      return pending.promise;
+    });
+    const request = f.search();
+    await started.promise;
+    f.connection.disconnect("client");
+    expect(f.vault.cancel).toHaveBeenCalledOnce();
+    pending.resolve({ state: "needs_approval" });
+    expect(await request).toEqual({ state: "cancelled" });
+  });
+
+  it("returns explicit ambiguous metadata selections and binds them to this connection and tab", async () => {
+    const f = setup();
+    const request = await f.search();
+    f.approveSearch();
+    const ready = await f.connection.call("client", {
+      action: "status",
+      requestId: request.requestId,
+    });
+    const accounts = ready.accounts as Array<{ selectionId: string; supported: boolean }>;
+    expect(accounts).toHaveLength(3);
+    expect(accounts.map((x) => x.supported)).toEqual([true, true, false]);
+    expect(JSON.stringify(ready)).not.toContain("11111111");
+    expect(
+      await f.connection.call("other", { action: "status", requestId: request.requestId }),
+    ).toEqual({ state: "denied" });
+    expect(
+      await f.connection.call("other", {
+        action: "login",
+        threadId: "thread",
+        tabId: "tab",
+        selectionId: accounts[0]!.selectionId,
+      }),
+    ).toEqual({ state: "denied" });
+    expect(
+      await f.connection.call("client", {
+        action: "login",
+        threadId: "thread",
+        tabId: "different",
+        selectionId: accounts[0]!.selectionId,
+      }),
+    ).toEqual({ state: "denied" });
+    expect(
+      await f.connection.call("client", {
+        action: "login",
+        threadId: "thread",
+        tabId: "tab",
+        selectionId: accounts[2]!.selectionId,
+      }),
+    ).toEqual({ state: "unsupported_provider" });
+    expect(f.target.loadURL).not.toHaveBeenCalled();
+  });
+
+  it("starts each subsequent selected login with fresh private approval and rejects stale ownership", async () => {
+    const f = setup();
+    const request = await f.search();
+    f.approveSearch();
+    const ready = await f.connection.call("client", {
+      action: "status",
+      requestId: request.requestId,
+    });
+    const selectionId = (ready.accounts as Array<{ selectionId: string }>)[0]!.selectionId;
+    const input = { action: "login", threadId: "thread", tabId: "tab", selectionId };
+    expect((await f.connection.call("client", input)).state).toBe("needs_approval");
+    expect((await f.connection.call("client", input)).state).toBe("needs_approval");
+    expect(f.vault.start).toHaveBeenCalledTimes(3);
+    const sessionIds = f.vault.start.mock.calls.map(
+      (call) => (call as unknown as [{ agentSessionId: string }])[0].agentSessionId,
+    );
+    expect(new Set(sessionIds).size).toBe(3);
+    f.revoke();
+    expect((await f.connection.call("client", input)).state).toBe("denied");
+  });
+
+  it("disconnect cancels current private work and invalidates all account selection handles", async () => {
+    const f = setup();
+    const request = await f.search();
+    f.approveSearch();
+    const ready = await f.connection.call("client", {
+      action: "status",
+      requestId: request.requestId,
+    });
+    const selectionId = (ready.accounts as Array<{ selectionId: string }>)[0]!.selectionId;
+    f.connection.disconnect("client");
+    expect(f.vault.cancel).toHaveBeenCalledOnce();
+    expect(
+      await f.connection.call("client", {
+        action: "login",
+        threadId: "thread",
+        tabId: "tab",
+        selectionId,
+      }),
+    ).toEqual({ state: "denied" });
+  });
+});
diff --git a/apps/desktop/src/preview/VaultConnection.ts b/apps/desktop/src/preview/VaultConnection.ts
new file mode 100644
index 000000000..7766b9dbc
--- /dev/null
+++ b/apps/desktop/src/preview/VaultConnection.ts
@@ -0,0 +1,182 @@
+// @effect-diagnostics nodeBuiltinImport:off globalDate:off -- Native broker capability IDs and bounded selection deadlines.
+import * as NodeCrypto from "node:crypto";
+import { accountFromMetadata, type VaultAccountMetadata } from "./VaultLoginPolicy.ts";
+import type { createPrivateVaultLogin } from "./PrivateVaultLogin.ts";
+
+type Tab = { target: Electron.WebContents; authorized: () => boolean };
+type Key = { threadId: string; tabId: string; agentSessionId: string };
+type Request = {
+  connectionId: string;
+  key: Key;
+  tab: Tab;
+  kind: "search" | "login";
+  expires: number;
+  accounts?: Array<{
+    selectionId: string;
+    name: string;
+    username: string;
+    origins: readonly string[];
+    supported: boolean;
+  }>;
+};
+const token = () => NodeCrypto.randomBytes(24).toString("base64url");
+const validKey = (v: unknown): v is string =>
+  typeof v === "string" &&
+  v.length > 0 &&
+  v.length <= 300 &&
+  ![...v].some((char) => char.charCodeAt(0) < 32 || char.charCodeAt(0) === 127);
+
+/** The socket supplies the connection identity; requester thread labels are untrusted.
+ * Actual tab binding, human consent and fresh biometric approval remain native. */
+export function createVaultConnection(options: {
+  getTab: (threadId: string, tabId: string) => Tab | undefined;
+  getVault: () => Promise<ReturnType<typeof createPrivateVaultLogin>>;
+}) {
+  const generations = new Map<string, number>();
+  const requests = new Map<string, Request>();
+  const selections = new Map<
+    string,
+    { connectionId: string; request: Request; item: VaultAccountMetadata }
+  >();
+  let vault: ReturnType<typeof createPrivateVaultLogin> | undefined;
+  const clear = (client: string) => {
+    for (const [id, request] of requests)
+      if (request.connectionId === client) {
+        vault?.cancel(request.key);
+        requests.delete(id);
+      }
+    for (const [id, selection] of selections)
+      if (selection.connectionId === client) selections.delete(id);
+  };
+  const prune = () => {
+    for (const [id, request] of requests)
+      if (request.expires <= Date.now() || !request.tab.authorized()) {
+        vault?.cancel(request.key);
+        requests.delete(id);
+        for (const [ref, selection] of selections)
+          if (selection.request === request) selections.delete(ref);
+      }
+  };
+  return {
+    disconnect(client: string) {
+      generations.set(client, (generations.get(client) ?? 0) + 1);
+      clear(client);
+    },
+    async call(client: string, input: unknown): Promise<Record<string, unknown>> {
+      const generation = generations.get(client) ?? 0;
+      prune();
+      if (!input || typeof input !== "object") return { state: "denied" };
+      const data = input as Record<string, unknown>;
+      if (data.action === "connection") return { state: "idle" };
+      vault ??= await options.getVault();
+      if ((generations.get(client) ?? 0) !== generation) return { state: "cancelled" };
+      if (data.action === "status" || data.action === "cancel") {
+        const request =
+          typeof data.requestId === "string" ? requests.get(data.requestId) : undefined;
+        if (!request || request.connectionId !== client) return { state: "denied" };
+        if (data.action === "cancel") {
+          const value = vault.cancel(request.key);
+          requests.delete(data.requestId as string);
+          for (const [id, selection] of selections)
+            if (selection.request === request) selections.delete(id);
+          return { state: value.state };
+        }
+        const value = vault.status(request.key);
+        if (request.kind === "search" && value.state === "accounts_ready") {
+          request.accounts ??= (value.accounts ?? []).slice(0, 50).map((item) => {
+            const selectionId = token();
+            selections.set(selectionId, { connectionId: client, request, item });
+            return {
+              selectionId,
+              name: item.name,
+              username: item.username,
+              origins: item.origins,
+              supported: accountFromMetadata(item) !== undefined,
+            };
+          });
+          return { state: "accounts_ready", requestId: data.requestId, accounts: request.accounts };
+        }
+        return { state: value.state, requestId: data.requestId };
+      }
+      if (!validKey(data.threadId) || !validKey(data.tabId)) return { state: "denied" };
+      const source = options.getTab(data.threadId, data.tabId);
+      const tab = source && {
+        target: source.target,
+        authorized: () => source.authorized() && (generations.get(client) ?? 0) === generation,
+      };
+      if (!tab || !tab.authorized()) return { state: "denied" };
+      const key = {
+        threadId: data.threadId,
+        tabId: data.tabId,
+        agentSessionId: `${client}/${token()}`,
+      };
+      if (requests.size >= 100) return { state: "busy" };
+      if (data.action === "search") {
+        if (
+          typeof data.query !== "string" ||
+          !data.query.trim() ||
+          data.query.length > 200 ||
+          [...data.query].some((char) => char.charCodeAt(0) < 32 || char.charCodeAt(0) === 127)
+        )
+          return { state: "denied" };
+        clear(client);
+        const requestId = token();
+        requests.set(requestId, {
+          connectionId: client,
+          key,
+          tab,
+          kind: "search",
+          expires: Date.now() + 600_000,
+        });
+        const value = await vault.start(key, tab.target, { query: data.query }, tab.authorized);
+        if (!tab.authorized()) {
+          vault.cancel(key);
+          requests.delete(requestId);
+          return { state: "cancelled" };
+        }
+        if (value.state !== "needs_approval") {
+          requests.delete(requestId);
+          return { state: value.state };
+        }
+        return { state: value.state, requestId };
+      }
+      if (data.action === "login") {
+        const selected =
+          typeof data.selectionId === "string" ? selections.get(data.selectionId) : undefined;
+        if (
+          !selected ||
+          selected.connectionId !== client ||
+          selected.request.key.threadId !== key.threadId ||
+          selected.request.key.tabId !== key.tabId ||
+          !selected.request.tab.authorized()
+        )
+          return { state: "denied" };
+        const account = accountFromMetadata(selected.item);
+        if (!account) return { state: "unsupported_provider" };
+        // Fixed adapter route only; agent arguments never contain a target URL.
+        await tab.target.loadURL(account.loginUrl);
+        if (!tab.authorized() || !selected.request.tab.authorized()) return { state: "denied" };
+        const requestId = token();
+        requests.set(requestId, {
+          connectionId: client,
+          key,
+          tab,
+          kind: "login",
+          expires: Date.now() + 600_000,
+        });
+        const value = await vault.start(key, tab.target, account, tab.authorized);
+        if (!tab.authorized()) {
+          vault.cancel(key);
+          requests.delete(requestId);
+          return { state: "cancelled" };
+        }
+        if (value.state !== "needs_approval") {
+          requests.delete(requestId);
+          return { state: value.state };
+        }
+        return { state: value.state, requestId };
+      }
+      return { state: "denied" };
+    },
+  };
+}
diff --git a/apps/desktop/src/preview/VaultDeviceUnlock.test.ts b/apps/desktop/src/preview/VaultDeviceUnlock.test.ts
new file mode 100644
index 000000000..cc027f525
--- /dev/null
+++ b/apps/desktop/src/preview/VaultDeviceUnlock.test.ts
@@ -0,0 +1,657 @@
+// @effect-diagnostics nodeBuiltinImport:off -- All filesystem and Electron calls below use in-memory ports.
+import { describe, expect, it, vi } from "vite-plus/test";
+
+type Entry = {
+  kind: "file" | "directory" | "symlink";
+  uid: number;
+  mode: number;
+  ino: number;
+  nlink: number;
+  bytes: Buffer;
+  size?: number;
+};
+
+const port = vi.hoisted(() => ({
+  entries: new Map<string, Entry>(),
+  events: [] as string[],
+  inode: 100,
+  uid: 0,
+  after: async (_event: string): Promise<void> => {},
+  touch: vi.fn<() => boolean>(),
+  encryption: vi.fn<() => boolean>(),
+  prompt: vi.fn<(reason: string) => Promise<void>>(),
+  encrypt: vi.fn<(value: string) => Buffer>(),
+  decrypt: vi.fn<(value: Buffer) => string>(),
+}));
+
+vi.mock("electron", () => ({
+  systemPreferences: { canPromptTouchID: port.touch, promptTouchID: port.prompt },
+  safeStorage: {
+    isEncryptionAvailable: port.encryption,
+    encryptString: port.encrypt,
+    decryptString: port.decrypt,
+  },
+}));
+vi.mock("node:fs", () => ({
+  constants: {
+    O_RDONLY: 0,
+    O_WRONLY: 1,
+    O_CREAT: 512,
+    O_EXCL: 2048,
+    O_NOFOLLOW: 256,
+    O_NONBLOCK: 4,
+  },
+}));
+vi.mock("node:fs/promises", () => {
+  const missing = () => Object.assign(new Error("PRIVATE_FS_DETAIL"), { code: "ENOENT" });
+  const get = (path: string) => {
+    const entry = port.entries.get(path);
+    if (!entry) throw missing();
+    return entry;
+  };
+  const stat = (entry: Entry) => ({
+    uid: entry.uid,
+    mode: entry.mode,
+    dev: 1,
+    ino: entry.ino,
+    nlink: entry.nlink,
+    size: entry.size ?? entry.bytes.length,
+    mtimeMs: 1,
+    ctimeMs: 1,
+    isFile: () => entry.kind === "file",
+    isDirectory: () => entry.kind === "directory",
+    isSymbolicLink: () => entry.kind === "symlink",
+  });
+  const event = async (name: string) => {
+    port.events.push(name);
+    await port.after(name);
+  };
+  return {
+    lstat: async (path: string) => {
+      const value = stat(get(path));
+      await event(`lstat:${path}`);
+      return value;
+    },
+    mkdir: async (path: string, options: { mode: number }) => {
+      if (port.entries.has(path))
+        throw Object.assign(new Error("PRIVATE_FS_DETAIL"), { code: "EEXIST" });
+      port.entries.set(path, {
+        kind: "directory",
+        uid: port.uid,
+        mode: options.mode,
+        ino: ++port.inode,
+        nlink: 1,
+        bytes: Buffer.alloc(0),
+      });
+      await event(`mkdir:${path}`);
+    },
+    open: async (path: string, flags: number, mode?: number) => {
+      if (flags & 512) {
+        if (port.entries.has(path))
+          throw Object.assign(new Error("PRIVATE_FS_DETAIL"), { code: "EEXIST" });
+        port.entries.set(path, {
+          kind: "file",
+          uid: port.uid,
+          mode: mode ?? 0,
+          ino: ++port.inode,
+          nlink: 1,
+          bytes: Buffer.alloc(0),
+        });
+      }
+      const entry = get(path);
+      if (entry.kind === "symlink") throw new Error("PRIVATE_FS_DETAIL");
+      await event(`open:${path}:${flags}`);
+      return {
+        stat: async () => {
+          const value = stat(entry);
+          await event(`stat:${path}`);
+          return value;
+        },
+        read: async (buffer: Buffer, offset: number, length: number) => {
+          const bytesRead = entry.bytes.copy(buffer, offset, 0, length);
+          await event(`read:${path}`);
+          return { bytesRead, buffer };
+        },
+        writeFile: async (bytes: Buffer) => {
+          entry.bytes = Buffer.from(bytes);
+          await event(`write:${path}`);
+        },
+        sync: async () => event(`sync:${path}`),
+        close: async () => event(`close:${path}`),
+      };
+    },
+    rename: async (source: string, target: string) => {
+      port.entries.set(target, get(source));
+      port.entries.delete(source);
+      await event(`rename:${target}`);
+    },
+    unlink: async (path: string) => {
+      get(path);
+      port.entries.delete(path);
+      await event(`unlink:${path}`);
+    },
+  };
+});
+
+import { createVaultDeviceUnlock } from "./VaultDeviceUnlock.ts";
+
+const path = "/fixture/private/enrollment.json";
+const key = "QUFB".repeat(22);
+const encrypted = Buffer.from("OS_ENCRYPTED_FIXTURE_BYTES_ONLY");
+const binding = {
+  version: 1,
+  server: "https://vault.scaleadvertisement.com",
+  owner: "businessabhish@gmail.com",
+};
+const sealed = { ...binding, encrypted: encrypted.toString("base64") };
+const failed = /^vault_device_unlock_failed$/;
+const cancelled = /^vault_device_unlock_cancelled$/;
+const unavailable = /^vault_device_unlock_unavailable$/;
+
+function setup(platform = "darwin") {
+  const descriptor = Object.getOwnPropertyDescriptor(process, "platform")!;
+  Object.defineProperty(process, "platform", { value: platform });
+  port.entries.clear();
+  port.events.length = 0;
+  port.inode = 100;
+  port.uid = process.getuid!();
+  port.after = async () => {};
+  port.touch.mockReset().mockReturnValue(true);
+  port.encryption.mockReset().mockReturnValue(true);
+  port.prompt.mockReset().mockImplementation(async () => {
+    port.events.push("prompt:success");
+  });
+  port.encrypt.mockReset().mockReturnValue(encrypted);
+  port.decrypt.mockReset().mockImplementation(() => {
+    port.events.push("decrypt");
+    return JSON.stringify({ ...binding, key });
+  });
+  const put = (name: string, changes: Partial<Entry> = {}) => {
+    const entry: Entry = {
+      kind: "file",
+      uid: port.uid,
+      mode: 0o600,
+      ino: ++port.inode,
+      nlink: 1,
+      bytes: Buffer.from(JSON.stringify(sealed)),
+      ...changes,
+    };
+    port.entries.set(name, entry);
+    return entry;
+  };
+  put("/", { kind: "directory", mode: 0o755 });
+  put("/fixture", { kind: "directory", mode: 0o755 });
+  put("/fixture/private", { kind: "directory", mode: 0o700 });
+  const file = put(path);
+  return {
+    vault: createVaultDeviceUnlock(path),
+    file,
+    put,
+    [Symbol.dispose]() {
+      Object.defineProperty(process, "platform", descriptor);
+    },
+  };
+}
+
+describe("private vault device unlock", () => {
+  it("preserves ciphertext across cancellation and requires approval in a fresh adapter", async () => {
+    using fixture = setup();
+    const before = Buffer.from(fixture.file.bytes);
+    expect(await fixture.vault.restore()).toBe(key);
+    fixture.vault.cancel();
+    const restarted = createVaultDeviceUnlock(path);
+    expect(await restarted.enrolled()).toBe(true);
+    expect(port.prompt).toHaveBeenCalledTimes(1);
+    expect(await restarted.restore()).toBe(key);
+    expect(port.prompt).toHaveBeenCalledTimes(2);
+    expect(port.entries.get(path)?.bytes).toEqual(before);
+    expect(port.encrypt).not.toHaveBeenCalled();
+  });
+
+  it("does not restore an explicitly forgotten enrollment in a fresh adapter", async () => {
+    using fixture = setup();
+    await fixture.vault.forget();
+    const restarted = createVaultDeviceUnlock(path);
+    expect(await restarted.enrolled()).toBe(false);
+    await expect(restarted.restore()).rejects.toThrow(failed);
+    expect(port.decrypt).not.toHaveBeenCalled();
+    expect(port.entries.has(path)).toBe(false);
+  });
+
+  it("exposes metadata without prompting or decrypting", async () => {
+    using fixture = setup();
+    expect(fixture.vault.available()).toBe(true);
+    expect(await fixture.vault.enrolled()).toBe(true);
+    expect(port.prompt).not.toHaveBeenCalled();
+    expect(port.decrypt).not.toHaveBeenCalled();
+  });
+
+  it("prompts successfully before reading or decrypting and returns only the key", async () => {
+    using fixture = setup();
+    expect(await fixture.vault.restore()).toBe(key);
+    expect(port.events[0]).toBe("prompt:success");
+    expect(port.events.indexOf(`read:${path}`)).toBeLessThan(port.events.indexOf("decrypt"));
+    expect(port.decrypt).toHaveBeenCalledWith(encrypted);
+    expect(port.events).toContain(`open:${path}:260`);
+  });
+
+  it("does not inspect or decrypt the enrollment when Touch ID is cancelled", async () => {
+    using fixture = setup();
+    port.prompt.mockRejectedValue(new Error("PRIVATE_TOUCH_ID_DETAIL"));
+    await expect(fixture.vault.restore()).rejects.toThrow(failed);
+    expect(port.events).toEqual([]);
+    expect(port.decrypt).not.toHaveBeenCalled();
+  });
+
+  it("writes only ciphertext and public bindings using a private atomic file", async () => {
+    using fixture = setup();
+    port.entries.delete(path);
+    port.entries.delete("/fixture/private");
+    await fixture.vault.enroll(key);
+    const stored = port.entries.get(path)!;
+    expect(stored.bytes.toString()).toBe(JSON.stringify(sealed));
+    expect(stored.bytes.toString()).not.toContain(key);
+    expect(stored.mode).toBe(0o600);
+    expect(port.entries.get("/fixture/private")?.mode).toBe(0o700);
+    expect(port.encrypt).toHaveBeenCalledWith(JSON.stringify({ ...binding, key }));
+    expect(port.events[0]).toBe("prompt:success");
+    expect(port.events.some((event) => event.startsWith("sync:"))).toBe(true);
+    expect(port.events).toContain(`rename:${path}`);
+    expect([...port.entries.keys()].some((name) => name.endsWith(".tmp"))).toBe(false);
+  });
+
+  it("does not encrypt or write after a cancelled enrollment prompt", async () => {
+    using fixture = setup();
+    const original = fixture.file.bytes;
+    port.prompt.mockRejectedValue(new Error("PRIVATE_TOUCH_ID_DETAIL"));
+    await expect(fixture.vault.enroll(key)).rejects.toThrow(failed);
+    expect(port.encrypt).not.toHaveBeenCalled();
+    expect(port.events).toEqual([]);
+    expect(fixture.file.bytes).toBe(original);
+  });
+
+  it.each(["short", "A".repeat(501), "A".repeat(40) + "\n", "!".repeat(88)])(
+    "refuses an invalid key before prompting: %s",
+    async (invalid) => {
+      using fixture = setup();
+      await expect(fixture.vault.enroll(invalid)).rejects.toThrow(failed);
+      expect(port.prompt).not.toHaveBeenCalled();
+      expect(port.encrypt).not.toHaveBeenCalled();
+    },
+  );
+
+  it.each([
+    { version: 2 },
+    { server: "https://other.example.com" },
+    { owner: "wrong@example.com" },
+    { encrypted: "not base64!!!" },
+    { encrypted: "AA==" },
+    { encrypted: encrypted.toString("base64").replace(/=$/, "") },
+    { encrypted: Buffer.alloc(8193).toString("base64") },
+    { key },
+  ])("refuses an invalid envelope without decrypting: %j", async (change) => {
+    using fixture = setup();
+    fixture.file.bytes = Buffer.from(JSON.stringify({ ...sealed, ...change }));
+    expect(await fixture.vault.enrolled()).toBe(false);
+    await expect(fixture.vault.restore()).rejects.toThrow(failed);
+    expect(port.decrypt).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    { kind: "symlink" as const },
+    { kind: "directory" as const },
+    { uid: -1 },
+    { mode: 0o644 },
+    { mode: 0o400 },
+    { mode: 0o4600 },
+    { nlink: 2 },
+    { size: 16385 },
+    { size: 0 },
+  ])("refuses unsafe file metadata without reading: %j", async (change) => {
+    using fixture = setup();
+    Object.assign(fixture.file, change);
+    expect(await fixture.vault.enrolled()).toBe(false);
+    await expect(fixture.vault.restore()).rejects.toThrow(failed);
+    await expect(fixture.vault.forget()).rejects.toThrow(failed);
+    expect(port.events.some((event) => event.startsWith("read:"))).toBe(false);
+    expect(port.entries.has(path)).toBe(true);
+    expect(port.decrypt).not.toHaveBeenCalled();
+  });
+
+  it.each([{ kind: "symlink" as const }, { uid: -1 }, { mode: 0o755 }, { mode: 0o770 }])(
+    "refuses unsafe parent directories without weakening permissions: %j",
