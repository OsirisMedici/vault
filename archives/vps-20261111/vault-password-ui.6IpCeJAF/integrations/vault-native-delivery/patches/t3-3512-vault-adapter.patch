+    },
+  );
+
+  it("keeps the master password and MFA outside argv and environment", async () => {
+    const cli = setup();
+    expect(await cli.unlock("SENTINEL_MASTER_ONLY", "123456")).toBeUndefined();
+    const login = port.commands.find((command) => command.args[0] === "login")!;
+    expect(login.password).toBe("SENTINEL_MASTER_ONLY\n");
+    expect(login.input).toBe("123456\n");
+    expect(login.args).toContain("/dev/fd/3");
+    expect(JSON.stringify(login.args)).not.toContain("SENTINEL_MASTER_ONLY");
+    expect(JSON.stringify(login.args)).not.toContain("123456");
+    expect(JSON.stringify(login.env)).not.toContain("SENTINEL_MASTER_ONLY");
+    expect(JSON.stringify(login.env)).not.toContain("123456");
+    cli.lock();
+  });
+
+  it("uses the registered item only after verifying the vault identity", async () => {
+    const cli = setup();
+    await cli.unlock("fixture-master", "123456");
+    expect(await cli.credential(account)).toEqual({
+      username: account.username,
+      password: "SENTINEL_ITEM_ONLY",
+    });
+    const get = port.commands.find((command) => command.args[0] === "get")!;
+    expect(get.args).toEqual(["get", "item", account.vaultItemId]);
+    expect(get.env.BW_SESSION).toBe(sessionFixture);
+    cli.lock();
+  });
+
+  it("does not read an item from a different vault account", async () => {
+    const cli = setup("locked");
+    port.respond = () => ({
+      stdout: JSON.stringify({
+        status: "locked",
+        serverUrl: server,
+        userEmail: "wrong@example.com",
+      }),
+    });
+    await expect(cli.unlock("fixture-master")).rejects.toThrow("wrong_vault_identity");
+    expect(port.commands.some((command) => command.args[0] === "get")).toBe(false);
+  });
+
+  it("cancels an unavailable biometric fallback instead of leaving a password prompt", async () => {
+    const cli = setup("locked");
+    const original = port.respond;
+    port.respond = (args) =>
+      args[0] === "unlock" ? { stderr: "Master password:" } : original(args);
+    await expect(cli.unlock()).rejects.toThrow("vault_cli_failed");
+    expect(port.commands.find((command) => command.args[0] === "unlock")?.killed).toBe(true);
+    expect(cli.isUnlocked()).toBe(false);
+  });
+
+  it("does not return CLI diagnostics containing secret payloads", async () => {
+    const cli = setup();
+    port.respond = () => ({
+      stdout: "SENTINEL_DIAGNOSTIC_ONLY",
+      stderr: "SENTINEL_DIAGNOSTIC_ONLY",
+      code: 1,
+    });
+    await expect(cli.unlock("fixture-master")).rejects.toThrow(/^vault_cli_failed$/);
+    expect(cli.isUnlocked()).toBe(false);
+  });
+
+  it("removes the unlock session and refuses credential reads at expiry", async () => {
+    vi.useFakeTimers();
+    try {
+      const cli = setup();
+      await cli.unlock("fixture-master", "123456");
+      await vi.advanceTimersByTimeAsync(15 * 60 * 1000 + 1);
+      expect(cli.isUnlocked()).toBe(false);
+      await expect(cli.credential(account)).rejects.toThrow("vault_locked");
+      expect(port.commands.some((command) => command.args[0] === "get")).toBe(false);
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it("restores a device connection through Touch ID without another password or MFA command", async () => {
+    const device = deviceFixture();
+    const cli = setup("locked", device);
+    await cli.unlockWithTouchId();
+    expect(device.restore).toHaveBeenCalledOnce();
+    expect(cli.isUnlocked()).toBe(true);
+    expect(port.commands.map((c) => c.args[0])).toEqual(["status", "sync"]);
+    expect(port.commands[0]?.env.BW_SESSION).toBe(sessionFixture);
+    cli.lock();
+  });
+
+  it("preserves the enrolled connection when a request locks, and revokes it only when forgotten", async () => {
+    const device = deviceFixture();
+    const cli = setup("locked", device);
+    const respond = port.respond;
+    let valid = true;
+    port.respond = (args) => {
+      // Real bw lock invalidates BW_SESSION, including a key sealed by this host.
+      if (args[0] === "lock") {
+        valid = false;
+        return {};
+      }
+      if (args[0] === "status" && !valid)
+        return {
+          stdout: JSON.stringify({ status: "locked", serverUrl: server, userEmail: owner }),
+        };
+      return respond(args);
+    };
+    await cli.unlockWithTouchId();
+    await cli.lock();
+    expect(cli.isUnlocked()).toBe(false);
+    await expect(cli.credential(account)).rejects.toThrow("vault_locked");
+    await expect(cli.unlockWithTouchId()).resolves.toBeUndefined();
+    expect(device.restore).toHaveBeenCalledTimes(2);
+    expect(port.commands.some((command) => command.args[0] === "lock")).toBe(false);
+    await cli.forgetDevice();
+    expect(valid).toBe(false);
+    expect(device.forget).toHaveBeenCalledOnce();
+    expect(cli.isUnlocked()).toBe(false);
+  });
+
+  it("distinguishes an invalidated saved session from a rejected fingerprint", async () => {
+    const cli = setup("locked", deviceFixture());
+    port.respond = () => ({
+      stdout: JSON.stringify({ status: "locked", serverUrl: server, userEmail: owner }),
+    });
+    await expect(cli.unlockWithTouchId()).rejects.toThrow("vault_session_invalidated");
+    expect(cli.isUnlocked()).toBe(false);
+    expect(port.commands.map((command) => command.args[0])).toEqual(["status"]);
+  });
+
+  it("enrolls only the verified unlock key, never the master password", async () => {
+    const device = deviceFixture();
+    const cli = setup("unauthenticated", device);
+    await cli.unlock("SENTINEL_MASTER_ONLY", "123456");
+    await cli.enrollDevice();
+    expect(device.enroll).toHaveBeenCalledExactlyOnceWith(sessionFixture);
+    cli.lock();
+  });
+
+  it("does not fall back to a master password when Touch ID is cancelled", async () => {
+    const device = deviceFixture();
+    device.restore.mockRejectedValue(new Error("device_unlock_cancelled"));
+    const cli = setup("locked", device);
+    await expect(cli.unlockWithTouchId()).rejects.toThrow("device_unlock_cancelled");
+    expect(cli.isUnlocked()).toBe(false);
+    expect(port.commands).toEqual([]);
+  });
+
+  it("refuses a restored key belonging to a different Vault identity", async () => {
+    const cli = setup("locked", deviceFixture());
+    port.respond = () => ({
+      stdout: JSON.stringify({
+        status: "unlocked",
+        serverUrl: server,
+        userEmail: "wrong@example.com",
+      }),
+    });
+    await expect(cli.unlockWithTouchId()).rejects.toThrow("wrong_vault_identity");
+    expect(cli.isUnlocked()).toBe(false);
+    await expect(cli.credential(account)).rejects.toThrow("vault_locked");
+    expect(port.commands.some((c) => c.args[0] === "get")).toBe(false);
+  });
+
+  it("ignores a pending fingerprint result after the Mac locks", async () => {
+    const device = deviceFixture();
+    const pending = Promise.withResolvers<string>();
+    device.restore.mockReturnValue(pending.promise);
+    const cli = setup("locked", device);
+    const unlocking = cli.unlockWithTouchId();
+    await Promise.resolve();
+    await cli.lock();
+    pending.resolve(sessionFixture);
+    await expect(unlocking).rejects.toThrow("unlock_cancelled");
+    expect(device.cancel).toHaveBeenCalled();
+    expect(cli.isUnlocked()).toBe(false);
+  });
+
+  it("requires a fresh fingerprint per request and can remove the saved connection", async () => {
+    const device = deviceFixture();
+    const cli = setup("locked", device);
+    await cli.unlockWithTouchId();
+    await cli.unlockWithTouchId();
+    expect(device.restore).toHaveBeenCalledTimes(2);
+    await cli.forgetDevice();
+    expect(device.forget).toHaveBeenCalledOnce();
+    expect(cli.isUnlocked()).toBe(false);
+  });
+});
diff --git a/apps/desktop/src/preview/VaultCli.ts b/apps/desktop/src/preview/VaultCli.ts
new file mode 100644
index 000000000..f6d3499d5
--- /dev/null
+++ b/apps/desktop/src/preview/VaultCli.ts
@@ -0,0 +1,346 @@
+// @effect-diagnostics nodeBuiltinImport:off -- Private desktop CLI adapter, never a tool transport.
+// @effect-diagnostics globalTimers:off -- Subprocess and private unlock deadlines are owned by this imperative Electron adapter.
+// @effect-diagnostics globalDate:off -- This private adapter checks expiry both before and after each subprocess result.
+import * as NodeChildProcess from "node:child_process";
+import * as NodeFSP from "node:fs/promises";
+import * as NodeOS from "node:os";
+import type * as NodeStream from "node:stream";
+
+import { credentialForAccount, type VaultAccount } from "./VaultLoginPolicy.ts";
+
+const SERVER = "https://vault.scaleadvertisement.com";
+const OWNER = "businessabhish@gmail.com";
+const MAX_OUTPUT = 4 * 1024 * 1024;
+const UNLOCK_MS = 15 * 60 * 1000;
+
+interface DeviceUnlock {
+  available(): boolean;
+  enrolled(): Promise<boolean>;
+  enroll(key: string): Promise<void>;
+  restore(): Promise<string>;
+  cancel(): void;
+  forget(): Promise<void>;
+}
+
+export interface VaultAccountMetadata {
+  readonly itemId: string;
+  readonly name: string;
+  readonly username: string;
+  readonly origins: string[];
+}
+
+const record = (value: unknown): value is Record<string, unknown> =>
+  typeof value === "object" && value !== null && !Array.isArray(value);
+const metadataText = (value: unknown): value is string =>
+  typeof value === "string" &&
+  value.trim().length > 0 &&
+  value.length <= 200 &&
+  ![...value].some((character) => character.charCodeAt(0) < 32 || character.charCodeAt(0) === 127);
+
+function accountMetadata(item: unknown): VaultAccountMetadata | undefined {
+  if (
+    !record(item) ||
+    item.type !== 1 ||
+    item.deletedDate ||
+    item.reprompt ||
+    typeof item.id !== "string" ||
+    !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(item.id) ||
+    !metadataText(item.name) ||
+    !record(item.login) ||
+    !metadataText(item.login.username)
+  )
+    return;
+  const origins = new Set<string>();
+  if (Array.isArray(item.login.uris)) {
+    for (const entry of item.login.uris) {
+      if (!record(entry) || typeof entry.uri !== "string" || entry.uri.length > 2048) continue;
+      try {
+        const url = new URL(entry.uri);
+        if (
+          url.protocol === "https:" &&
+          !url.username &&
+          !url.password &&
+          !url.port &&
+          url.hostname.length <= 253
+        )
+          origins.add(url.origin);
+      } catch {
+        // Invalid saved URLs do not become routing authority or tool output.
+      }
+      if (origins.size === 10) break;
+    }
+  }
+  return { itemId: item.id, name: item.name, username: item.login.username, origins: [...origins] };
+}
+
+/** The returned object remains in the desktop main process, never in renderer state. */
+export function createVaultCli(profilePath: string, device?: DeviceUnlock) {
+  let session: string | undefined;
+  let expires = 0;
+  let generation = 0;
+  let expiryTimer: ReturnType<typeof setTimeout> | undefined;
+  let locking: Promise<void> = Promise.resolve();
+  const children = new Map<NodeChildProcess.ChildProcess, () => void>();
+  let removalFailed = false;
+  let forgetting = 0;
+  const check = (current: number | null) => {
+    if (current !== null && current !== generation) throw new Error("unlock_cancelled");
+  };
+  const parsed = (output: string): unknown => {
+    try {
+      return JSON.parse(output);
+    } catch {
+      throw new Error("vault_cli_failed");
+    }
+  };
+
+  const run = async (
+    args: readonly string[],
+    input: { password?: string; code?: string; biometric?: boolean; key?: string } = {},
+    current: number | null = generation,
+  ): Promise<string> => {
+    check(current);
+    await NodeFSP.mkdir(profilePath, { recursive: true, mode: 0o700 });
+    check(current);
+    await NodeFSP.chmod(profilePath, 0o700);
+    check(current);
+    const env: Record<string, string> = {
+      HOME: NodeOS.homedir(),
+      PATH: "/opt/homebrew/bin:/usr/bin:/bin",
+      BITWARDENCLI_APPDATA_DIR: profilePath,
+      NODE_TLS_REJECT_UNAUTHORIZED: "1",
+      BITWARDEN_DESKTOP_PROXY_PATH: "/Applications/Bitwarden.app/Contents/MacOS/desktop_proxy",
+    };
+    if (input.key) env.BW_SESSION = input.key;
+    if (!input.biometric && !input.code) env.BW_NOINTERACTION = "true";
+    const command = [...args];
+    if (input.password !== undefined) command.push("--passwordfile", "/dev/fd/3");
+    return new Promise((resolve, reject) => {
+      const child = NodeChildProcess.spawn("/opt/homebrew/bin/bw", command, {
+        env,
+        stdio: ["pipe", "pipe", "pipe", "pipe"],
+      });
+      let output = "";
+      let diagnostics = "";
+      let suppliedCode = false;
+      let settled = false;
+      const finish = (ok: boolean) => {
+        if (settled) return;
+        settled = true;
+        clearTimeout(timer);
+        children.delete(child);
+        const result = output.trim();
+        output = diagnostics = "";
+        if (current !== null && current !== generation) reject(new Error("unlock_cancelled"));
+        else if (ok) resolve(result);
+        else reject(new Error("vault_cli_failed"));
+      };
+      // Only the captured child is terminated. CLI output must never reach logs.
+      const timer = setTimeout(() => {
+        child.kill();
+        finish(false);
+      }, 60_000);
+      if (current !== null)
+        children.set(child, () => {
+          child.kill();
+          finish(false);
+        });
+      child.stdout?.on("data", (chunk: Buffer) => {
+        if (settled) return;
+        output += chunk.toString("utf8");
+        if (output.length > MAX_OUTPUT) {
+          child.kill();
+          finish(false);
+        }
+      });
+      child.stderr?.on("data", (chunk: Buffer) => {
+        if (settled) return;
+        diagnostics = (diagnostics + chunk.toString("utf8")).slice(-4096);
+        if (input.code && !suppliedCode && diagnostics.includes("Two-step login code:")) {
+          suppliedCode = true;
+          child.stdin?.end(`${input.code}\n`);
+        }
+        // Never leave an invisible password prompt after a cancelled biometric request.
+        if (input.biometric && diagnostics.includes("Master password:")) {
+          child.kill();
+          finish(false);
+        }
+      });
+      child.on("error", () => finish(false));
+      child.on("close", (code) => finish(code === 0));
+      child.stdin?.on("error", () => {});
+      const passwordPipe = child.stdio[3] as NodeStream.Writable;
+      passwordPipe.on("error", () => {});
+      passwordPipe.end(input.password === undefined ? "" : `${input.password}\n`);
+      if (!input.code) child.stdin?.end();
+    });
+  };
+
+  const lock = () => {
+    generation++;
+    if (!forgetting) device?.cancel();
+    clearTimeout(expiryTimer);
+    session = undefined;
+    expires = 0;
+    for (const cancel of children.values()) cancel();
+    children.clear();
+    // bw lock invalidates the key sealed for this device. A request lock clears
+    // active access; the encrypted connection survives for the next fingerprint.
+    // Explicit device removal below also invalidates the CLI's backing state.
+    return locking;
+  };
+
+  const acceptKey = async (key: string, current: number) => {
+    if (generation !== current || !/^[A-Za-z0-9+/=]{40,500}$/.test(key))
+      throw new Error("unlock_cancelled");
+    const verified = parsed(await run(["status"], { key }, current)) as {
+      status: string;
+      userEmail?: string;
+      serverUrl?: string;
+    };
+    if (generation !== current) throw new Error("unlock_cancelled");
+    if (verified.userEmail !== OWNER || verified.serverUrl?.replace(/\/$/, "") !== SERVER)
+      throw new Error("wrong_vault_identity");
+    if (verified.status !== "unlocked") throw new Error("vault_session_invalidated");
+    await run(["sync"], { key }, current);
+    if (generation !== current) throw new Error("unlock_cancelled");
+    session = key;
+    expires = Date.now() + UNLOCK_MS;
+    clearTimeout(expiryTimer);
+    expiryTimer = setTimeout(lock, UNLOCK_MS);
+    expiryTimer.unref();
+  };
+
+  return {
+    lock,
+    isUnlocked: () => session !== undefined && Date.now() < expires,
+    deviceAvailable: () => device?.available() ?? false,
+    deviceEnrolled: () => device?.enrolled() ?? Promise.resolve(false),
+    async enrollDevice() {
+      const key = session;
+      const current = generation;
+      if (!device?.available() || !key || Date.now() >= expires)
+        throw new Error("device_enrollment_unavailable");
+      await device.enroll(key);
+      if (generation !== current) throw new Error("unlock_cancelled");
+    },
+    async unlockWithTouchId() {
+      if (!device?.available()) throw new Error("touch_id_unavailable");
+      const current = ++generation;
+      clearTimeout(expiryTimer);
+      session = undefined;
+      expires = 0;
+      await locking;
+      if (removalFailed) throw new Error("vault_device_removal_failed");
+      if (generation !== current) throw new Error("unlock_cancelled");
+      const key = await device.restore();
+      if (generation !== current) throw new Error("unlock_cancelled");
+      await acceptKey(key, current);
+    },
+    async forgetDevice() {
+      lock();
+      const previous = locking;
+      forgetting++;
+      const forgotten = device?.forget();
+      // Revocation survives ordinary request cancellation. No restore may pass
+      // until both local deletion and CLI invalidation have finished.
+      const revocation = Promise.allSettled([previous, forgotten, run(["lock"], {}, null)]).then(
+        (results) => {
+          forgetting--;
+          removalFailed = results.some((result) => result.status === "rejected");
+          if (removalFailed) throw new Error("vault_device_removal_failed");
+        },
+      );
+      locking = revocation.catch(() => {});
+      await revocation;
+    },
+    async unlock(password?: string, code?: string) {
+      const current = ++generation;
+      clearTimeout(expiryTimer);
+      session = undefined;
+      expires = 0;
+      await locking;
+      if (removalFailed) throw new Error("vault_device_removal_failed");
+      if (generation !== current) throw new Error("unlock_cancelled");
+      const status = parsed(await run(["status"], {}, current)) as {
+        status: string;
+        serverUrl?: string;
+        userEmail?: string;
+      };
+      let key: string;
+      if (status.status === "unauthenticated") {
+        if (!password) throw new Error("private_enrollment_required");
+        await run(["config", "server", SERVER], {}, current);
+        key = await run(
+          ["login", OWNER, "--method", "0", "--raw"],
+          {
+            password,
+            ...(code ? { code } : {}),
+          },
+          current,
+        );
+      } else {
+        if (status.serverUrl?.replace(/\/$/, "") !== SERVER || status.userEmail !== OWNER)
+          throw new Error("wrong_vault_identity");
+        key = await run(
+          ["unlock", "--raw"],
+          password === undefined ? { biometric: true } : { password },
+          current,
+        );
+      }
+      await acceptKey(key, current);
+    },
+    async searchAccounts(query: string): Promise<VaultAccountMetadata[]> {
+      if (!metadataText(query)) throw new Error("invalid_account_query");
+      const key = session;
+      if (!key) throw new Error("vault_locked");
+      const current = generation;
+      const requireSession = () => {
+        if (!key || current !== generation || Date.now() >= expires)
+          throw new Error("vault_locked");
+      };
+      requireSession();
+      let output: string;
+      try {
+        output = await run(["list", "items"], { key }, current);
+      } catch (error) {
+        requireSession();
+        throw error;
+      }
+      requireSession();
+      const items = parsed(output);
+      if (!Array.isArray(items)) throw new Error("vault_cli_failed");
+      const needle = query.trim().toLowerCase();
+      const results: VaultAccountMetadata[] = [];
+      const seen = new Set<string>();
+      for (const item of items) {
+        const metadata = accountMetadata(item);
+        if (!metadata || seen.has(metadata.itemId)) continue;
+        if (
+          ![metadata.name, metadata.username, ...metadata.origins].some((text) =>
+            text.toLowerCase().includes(needle),
+          )
+        )
+          continue;
+        seen.add(metadata.itemId);
+        results.push(metadata);
+        if (results.length === 50) break;
+      }
+      requireSession();
+      return results;
+    },
+    async credential(account: VaultAccount) {
+      const key = session;
+      const current = generation;
+      if (!key || Date.now() >= expires) {
+        lock();
+        throw new Error("vault_locked");
+      }
+      const item: unknown = parsed(
+        await run(["get", "item", account.vaultItemId], { key }, current),
+      );
+      if (generation !== current || Date.now() >= expires) throw new Error("vault_locked");
+      return credentialForAccount(item, account);
+    },
+  };
+}
