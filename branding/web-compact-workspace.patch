+  box-shadow: 0 0.75rem 1.875rem rgb(0 0 0 / 22%);
+  animation: vault-workspace-settings-in 140ms ease-out both;
+}
+
+.vault-workspace-settings-title {
+  padding: 0.5rem 0.625rem;
+  color: rgb(var(--color-text-muted));
+  font-size: 0.75rem;
+  font-weight: 600;
+}
+
+.vault-workspace-settings :is(a, button) {
+  display: flex;
+  align-items: center;
+  gap: 0.625rem;
+  width: 100%;
+  min-height: 2.125rem;
+  padding: 0.375rem 0.625rem;
+  border-radius: 0.375rem;
+  color: inherit;
+  font-size: 0.875rem;
+  text-align: start;
+  text-decoration: none;
+}
+
+.vault-workspace-settings :is(a, button):is(:hover, :focus-visible) {
+  background: rgb(var(--color-background));
+}
+
+.vault-workspace-settings hr {
+  margin: 0.375rem 0.5rem;
+  border-color: rgb(var(--color-secondary-300));
+}
+
+.vault-workspace-tools {
+  padding-inline-start: 1.5rem;
+}
+
+@keyframes vault-workspace-settings-in {
+  from { opacity: 0; transform: translateY(0.25rem); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .vault-workspace-settings {
+    animation: none;
+  }
+}
